---
import { Font } from 'astro:assets';
import '../theme/tokens.css';
import '../theme/base.css';

interface Props {
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
  description?: string;
  /** Set false to leave out the site's icons, for a page that links its own in the head slot. */
  icon?: boolean;
  /** Keep the page out of search: a robots noindex, and no canonical URL or og:url. */
  noindex?: boolean;
}

const { title, description = 'A testing ground for web experiments.', icon = true, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · thesandbox.page` : 'thesandbox.page';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply the stored theme before first paint (see src/theme/theme.ts).
      try {
        if (localStorage.getItem('theme') === 'light') document.documentElement.dataset.theme = 'light';
      } catch {}
    </script>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {icon && <link rel="icon" type="image/png" sizes="32x32" href="/favicon-hdr.png" />}
    {icon && <link rel="apple-touch-icon" href="/apple-touch-icon.png" />}
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <Font cssVariable="--font-display" preload />
    <title>{fullTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
