---
import { Font } from 'astro:assets';
import Bare from '../../layouts/Bare.astro';
---

<Bare
  title="Tintype"
  description="A wet-plate portrait studio: coat a sheet of black iron with collodion, sit still before your camera, then develop and fix your tintype under the safelight."
>
  <Font cssVariable="--font-tintype" slot="head" />

  <main class="tintype" data-tintype data-stage="open" data-light="day">
    <div class="room" aria-hidden="true">
      <div class="room-day"></div>
      <div class="room-safe"></div>
    </div>

    <section class="bench" data-bench>
      <div class="stand" data-stand>
        <div class="plate" data-plate>
          <canvas class="sheet" data-canvas role="img" aria-label="A blank tintype plate: a sheet of black iron"
          ></canvas>
          <p class="count" data-count aria-live="assertive" hidden></p>
        </div>
        <div class="tank" data-tank aria-hidden="true"><i></i></div>
      </div>
      <p class="unsupported" data-unsupported hidden>
        This browser can't open a WebGL 2 context, which the plate is drawn with.
      </p>
      <noscript>
        <p class="unsupported">The studio runs on JavaScript, which is off.</p>
      </noscript>
    </section>

    <aside class="desk">
      <header class="masthead">
        <a class="home" href="/" title="Back to thesandbox.page">thesandbox.page</a>
        <h1>Tintype</h1>
      </header>

      <ol class="steps" data-steps aria-label="The process">
        <li data-step="compose">Compose</li>
        <li data-step="coat">Coat</li>
        <li data-step="bath">Sensitize</li>
        <li data-step="expose">Expose</li>
        <li data-step="develop">Develop</li>
        <li data-step="fix">Fix</li>
        <li data-step="varnish">Varnish</li>
      </ol>

      <p class="say" data-say aria-live="polite">
        Sit for a portrait the way it was done in the 1860s: on a sheet of black iron, coated and developed by hand
        while it is still wet.
      </p>

      <div class="controls">
        <div class="group" data-for="open">
          <button class="primary" type="button" data-source="camera">Use my camera</button>
          <button type="button" data-source="photo">Bring a photograph</button>
          <button type="button" data-source="card">Use the colour chart</button>
          <p class="fine" data-source-note>The picture never leaves this page.</p>
        </div>

        <div class="group" data-for="compose" hidden>
          <fieldset class="exposure" data-exposure>
            <legend>Exposure</legend>
            <div class="seconds">
              <label><input type="radio" name="exposure" value="1" /><span>1</span></label>
              <label><input type="radio" name="exposure" value="2" /><span>2</span></label>
              <label><input type="radio" name="exposure" value="3" /><span>3</span></label>
              <label><input type="radio" name="exposure" value="4" checked /><span>4</span></label>
              <label><input type="radio" name="exposure" value="6" /><span>6</span></label>
              <label><input type="radio" name="exposure" value="8" /><span>8</span></label>
              <label><input type="radio" name="exposure" value="12" /><span>12</span></label>
              <span class="unit">seconds</span>
            </div>
            <p class="fine" data-meter></p>
          </fieldset>
          <button type="button" data-blue aria-pressed="false">Look through blue glass</button>
          <button class="primary" type="button" data-to-coat>Coat a plate</button>
          <button class="quiet" type="button" data-to-open>Change the sitter</button>
        </div>

        <div class="group" data-for="coat" hidden>
          <button type="button" data-auto-coat>Pour it for me</button>
          <button class="primary" type="button" data-to-bath disabled>Into the silver bath</button>
        </div>

        <div class="group" data-for="bath" hidden>
          <button class="primary" type="button" data-lift disabled>Lift it out</button>
          <button type="button" data-rebath hidden>Back in the bath</button>
          <button class="primary" type="button" data-to-expose hidden>Load the holder</button>
        </div>

        <div class="group" data-for="expose" hidden>
          <button class="primary" type="button" data-uncap>Take the cap off the lens</button>
        </div>

        <div class="group" data-for="develop" hidden>
          <p class="clock" data-devclock aria-live="off"></p>
          <button type="button" data-auto-dev>Pour it for me</button>
          <button class="primary" type="button" data-rinse disabled>Rinse</button>
        </div>

        <div class="group" data-for="fix" hidden>
          <button class="primary" type="button" data-to-fix>Into the fixer</button>
          <button class="primary" type="button" data-to-varnish hidden>Dry it off</button>
        </div>

        <div class="group" data-for="varnish" hidden>
          <button class="primary" type="button" data-varnish>Varnish it</button>
          <button type="button" data-bare>Leave it bare</button>
        </div>

        <div class="group" data-for="done" hidden>
          <button class="primary" type="button" data-save>Save the plate</button>
          <button type="button" data-again>Sit again</button>
        </div>
      </div>

      <section class="book" data-book hidden>
        <h2>This sitting</h2>
        <ul data-book-list></ul>
      </section>

      <details class="notes">
        <summary>How a tintype works</summary>
        <p>
          A tintype is made directly on a thin sheet of iron, lacquered black. The plate is coated with collodion,
          guncotton dissolved in ether and alcohol and salted with iodide, then dipped in silver nitrate, which turns
          the film creamy and sensitive to light. It has to be exposed and developed while it is still wet, inside about
          fifteen minutes.
        </p>
        <p>
          Collodion sees only blue and ultraviolet light. Blue eyes come out pale, red lips and freckles dark, and a
          blue sky white. Your camera's colours are weighed the same way here.
        </p>
        <p>
          The developer brings up a thin silver negative. Once the fixer has dissolved the unused cream, the silver
          reads as a positive against the black iron. There is no negative to print from, so every plate is the only
          copy, and it is a mirror image: you see yourself as you would in a glass.
        </p>
        <p>
          Studio exposures in daylight took a few seconds, and sitters were braced to keep still. Anything that moves
          while the lens is open leaves a ghost.
        </p>
      </details>
    </aside>

    <input type="file" accept="image/*" data-file hidden />
    <video data-video playsinline muted hidden></video>
  </main>
</Bare>

<style>
  .tintype {
    --ink: #ece4d3;
    --muted: #a69d8c;
    --line: color-mix(in oklab, currentColor 26%, transparent);
    --fill: #ece4d3;
    --on-fill: #15120e;
    --desk-w: 380px;
    --tx: 0;
    --ty: 0;

    position: relative;
    min-height: 100dvh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--desk-w);
    color: var(--ink);
    background: #0b0a09;
    font:
      400 16px/1.45 var(--font-tintype),
      Georgia,
      serif;
    font-optical-sizing: auto;
    -webkit-font-smoothing: antialiased;
    transition: color 1.4s ease;
  }

  .tintype[data-light='safe'] {
    --ink: #ff9f80;
    --muted: #b8553c;
    --fill: #ff9f80;
    --on-fill: #1c0602;
  }

  .room {
    position: fixed;
    inset: 0;
    pointer-events: none;
  }

  .room > div {
    position: absolute;
    inset: 0;
    transition: opacity 1.4s ease;
  }

  .room-day {
    background:
      radial-gradient(ellipse 70% 60% at 18% -8%, rgb(196 206 222 / 0.16), transparent 70%),
      radial-gradient(ellipse 90% 70% at 50% 110%, rgb(60 44 30 / 0.35), transparent 70%), #0b0a09;
  }

  .room-safe {
    opacity: 0;
    background:
      radial-gradient(ellipse 60% 50% at 50% -12%, rgb(255 52 18 / 0.32), transparent 72%),
      radial-gradient(ellipse 100% 80% at 50% 120%, rgb(70 8 2 / 0.5), transparent 70%), #0d0302;
  }

  .tintype[data-light='safe'] .room-safe {
    opacity: 1;
  }

  .bench {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100dvh;
    padding: 48px;
    overflow: hidden;
  }

  .stand {
    position: relative;
    display: grid;
    place-items: center;
    width: min(calc((100dvh - 96px) * 0.8), 100%);
    perspective: 1400px;
  }

  .plate {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    transform: rotateX(calc(var(--ty) * -14deg)) rotateY(calc(var(--tx) * 14deg));
    transition: translate 1.1s cubic-bezier(0.5, 0, 0.3, 1);
    filter: drop-shadow(0 22px 34px rgb(0 0 0 / 0.6));
  }

  .sheet {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: none;
  }

  .tintype[data-stage='coat'] .sheet,
  .tintype[data-stage='develop'] .sheet {
    cursor: crosshair;
  }

  .count {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    font-size: clamp(96px, 22vh, 220px);
    font-weight: 400;
    font-style: italic;
    line-height: 1;
    color: #f4ecdc;
    text-shadow: 0 2px 30px rgb(0 0 0 / 0.6);
    font-variant-numeric: lining-nums;
    pointer-events: none;
  }

  .count[hidden] {
    display: none;
  }

  /* The silver bath: a black glass tank the plate is lowered into. */
  .tank {
    position: absolute;
    left: -9%;
    right: -9%;
    bottom: -7%;
    height: 78%;
    border-radius: 3px 3px 6px 6px;
    background:
      linear-gradient(90deg, rgb(255 120 90 / 0.08), transparent 12%, transparent 88%, rgb(255 120 90 / 0.06)),
      linear-gradient(rgb(26 5 2 / 0.93), rgb(9 2 1 / 0.97));
    box-shadow:
      inset 0 1px 0 rgb(255 140 110 / 0.35),
      0 30px 60px rgb(0 0 0 / 0.6);
    opacity: 0;
    translate: 0 30%;
    transition:
      opacity 0.9s ease,
      translate 0.9s ease;
    pointer-events: none;
  }

  .tank i {
    position: absolute;
    left: 3%;
    right: 3%;
    top: 7%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(255 150 120 / 0.45) 20%, rgb(255 150 120 / 0.45) 80%, transparent);
  }

  .tintype[data-stage='bath'] .tank {
    opacity: 1;
    translate: 0 0;
  }

  .tintype[data-dipped] .plate {
    translate: 0 64%;
  }

  .unsupported {
    max-width: 32ch;
    text-align: center;
    color: var(--muted);
  }

  .unsupported[hidden] {
    display: none;
  }

  .desk {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 44px 40px 40px 8px;
    min-height: 100dvh;
  }

  .masthead {
    display: grid;
    gap: 2px;
  }

  .home {
    width: fit-content;
    color: var(--muted);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .home:hover,
  .home:focus-visible {
    color: var(--ink);
  }

  h1 {
    margin: 0;
    font-size: 64px;
    font-weight: 500;
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .steps {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    margin: 0;
    padding: 12px 0;
    border-block: 1px solid var(--line);
    list-style: none;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .steps li {
    transition: color 0.4s ease;
  }

  .steps li[data-state='done'] {
    color: color-mix(in oklab, var(--muted) 60%, transparent);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }

  .steps li[data-state='now'] {
    color: var(--ink);
  }

  .say {
    margin: 0;
    min-height: 4.4em;
    font-size: 20px;
    line-height: 1.38;
    text-wrap: pretty;
  }

  .controls {
    display: grid;
  }

  .group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .group[hidden] {
    display: none;
  }

  button {
    font: inherit;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: inherit;
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 9px 16px 10px;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      opacity 0.2s ease;
  }

  button:hover:not(:disabled),
  button:focus-visible {
    border-color: currentColor;
  }

  button:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 2px;
  }

  button.primary {
    background: var(--fill);
    border-color: var(--fill);
    color: var(--on-fill);
  }

  button.primary:hover:not(:disabled) {
    background: color-mix(in oklab, var(--fill) 86%, white);
  }

  button.quiet {
    border-color: transparent;
    padding-inline: 4px;
    color: var(--muted);
  }

  button:disabled {
    opacity: 0.38;
    cursor: default;
  }

  button[hidden] {
    display: none;
  }

  button[aria-pressed='true'] {
    border-color: currentColor;
    background: color-mix(in oklab, #3b62d9 30%, transparent);
  }

  .fine {
    flex-basis: 100%;
    margin: 4px 0 0;
    font-size: 13px;
    color: var(--muted);
  }

  .fine:empty {
    display: none;
  }

  .exposure {
    flex-basis: 100%;
    margin: 0 0 6px;
    padding: 0;
    border: 0;
  }

  .exposure legend {
    padding: 0;
    margin-bottom: 8px;
    font-size: 13px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .seconds {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }

  .seconds label {
    position: relative;
  }

  .seconds input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .seconds label span {
    display: grid;
    place-items: center;
    min-width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 50%;
    font-size: 16px;
    font-variant-numeric: lining-nums tabular-nums;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .seconds input:checked + span {
    background: var(--fill);
    border-color: var(--fill);
    color: var(--on-fill);
  }

  .seconds input:focus-visible + span {
    outline: 1px solid currentColor;
    outline-offset: 2px;
  }

  .seconds label[data-suggested] span {
    border-color: currentColor;
  }

  .unit {
    margin-left: 4px;
    font-size: 14px;
    font-style: italic;
    color: var(--muted);
  }

  .clock {
    flex-basis: 100%;
    margin: 0 0 4px;
    font-size: 40px;
    font-style: italic;
    line-height: 1;
    font-variant-numeric: lining-nums tabular-nums;
  }

  .clock:empty {
    display: none;
  }

  .book[hidden] {
    display: none;
  }

  .book h2 {
    margin: 0 0 10px;
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .book ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .book button {
    display: block;
    padding: 0;
    border: 0;
    background: none;
  }

  .book img {
    display: block;
    width: 56px;
    height: 70px;
    filter: drop-shadow(0 4px 6px rgb(0 0 0 / 0.5));
  }

  .notes {
    margin-top: auto;
    padding-top: 14px;
    border-top: 1px solid var(--line);
    font-size: 15px;
    color: var(--muted);
  }

  .notes summary {
    width: fit-content;
    cursor: pointer;
    color: var(--ink);
    font-style: italic;
  }

  .notes p {
    margin: 10px 0 0;
    max-width: 44ch;
    text-wrap: pretty;
  }

  @media (max-width: 900px) {
    .tintype {
      grid-template-columns: minmax(0, 1fr);
    }

    .bench {
      min-height: 0;
      padding: 16px 16px 8px;
    }

    .stand {
      width: min(100%, calc((100dvh - 260px) * 0.8), 560px);
    }

    .desk {
      min-height: 0;
      padding: 8px 16px 28px;
      gap: 16px;
    }

    .masthead {
      grid-row: 1;
    }

    h1 {
      font-size: 44px;
    }

    .say {
      min-height: 0;
      font-size: 18px;
    }

    .notes {
      margin-top: 8px;
    }
  }
</style>

<script>
  import { start } from './_app';

  const root = document.querySelector<HTMLElement>('[data-tintype]');
  if (root) start(root);
</script>
