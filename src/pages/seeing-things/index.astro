  }
  @keyframes seeing-turn {
    to {
      transform: translate(var(--dx), var(--dy)) rotate(-90deg);
    }
  }

  /* Chaser */
  .seeing .chaser-ground {
    fill: #bebdb9;
  }
  .seeing .chase {
    fill: var(--chase, #d98ad9);
    animation: seeing-chase 1.5s step-end infinite;
    animation-play-state: paused;
  }
  .seeing [data-run] .chase {
    animation-play-state: running;
  }
  .seeing .cross {
    fill: none;
    stroke: #000;
    stroke-width: 3;
  }
  @keyframes seeing-chase {
    0% {
      opacity: 0;
    }
    6.667% {
      opacity: 1;
    }
  }

  /* Mortar */
  .seeing .tile-light {
    fill: #fbfaf6;
  }
  .seeing .tile-dark {
    fill: #0f0e0c;
  }
  .seeing .mortar {
    fill: none;
    stroke: #8b8882;
    stroke-width: 5;
  }

  /* Buses */
  .seeing .bus-light {
    fill: var(--bus-light, #fbfaf6);
  }
  .seeing .bus-dark {
    fill: var(--bus-dark, #0f0e0c);
  }
  .seeing .bus-yellow {
    fill: #f5c400;
  }
  .seeing .bus-blue {
    fill: #1c2b86;
  }

  /* Halo */
  .seeing .halo-ring {
    fill: #2747c8;
  }
  .seeing .halo-centre {
    fill: #e3a32a;
    transition: transform 1.2s cubic-bezier(0.6, 0, 0.2, 1) 0.3s;
  }
  .seeing [data-state='checked'] .halo-fixed {
    transform: translateX(var(--meet-left));
  }
  .seeing [data-state='checked'] .halo-set {
