---
import { Font } from 'astro:assets';
import Bare from '../../layouts/Bare.astro';
import {
  busesFigure,
  chaserFigure,
  driftFigure,
  finsFigure,
  gridFigure,
  haloFigure,
  HALO,
  HALO_MEET,
  mortarFigure,
  spiralFigure,
  stripesFigure,
  tablesFigure,
} from './_figures';

// Where each measured figure starts on a first visit; Again picks a fresh start.
const start = { fins: 412, tables: 214, halo: 29, mortar: 1.8, stripes: 152 };

const plates = [
  { id: 'fins', num: '01', name: 'Fins' },
  { id: 'grid', num: '02', name: 'Grid' },
  { id: 'tables', num: '03', name: 'Tables' },
  { id: 'chaser', num: '04', name: 'Chaser' },
  { id: 'mortar', num: '05', name: 'Mortar' },
  { id: 'buses', num: '06', name: 'Buses' },
  { id: 'halo', num: '07', name: 'Halo' },
  { id: 'spiral', num: '08', name: 'Spiral' },
  { id: 'stripes', num: '09', name: 'Stripes' },
  { id: 'drift', num: '10', name: 'Drift' },
];
---

<Bare
  title="Seeing things"
  description="Ten figures that fool the eye: set each measured one until it looks right and see how far off you were, and watch the others show you what isn't there."
>
  <Font cssVariable="--font-seeing" slot="head" />

  <main class="seeing" data-seeing data-opener>
    <header class="opener" id="top">
      <svg class="ouchi" aria-hidden="true">
        <defs>
          <pattern id="seeing-ouchi-h" width="48" height="12" patternUnits="userSpaceOnUse">
            <rect width="48" height="12" fill="#fbfaf6"></rect>
            <rect width="24" height="6" fill="#16130f"></rect>
            <rect x="24" y="6" width="24" height="6" fill="#16130f"></rect>
          </pattern>
          <pattern
            id="seeing-ouchi-v"
            width="48"
            height="12"
            patternUnits="userSpaceOnUse"
            patternTransform="rotate(90)"
          >
            <rect width="48" height="12" fill="#fbfaf6"></rect>
            <rect width="24" height="6" fill="#16130f"></rect>
            <rect x="24" y="6" width="24" height="6" fill="#16130f"></rect>
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#seeing-ouchi-h)"></rect>
        <circle class="ouchi-disc" cx="70%" cy="44%" r="240" fill="url(#seeing-ouchi-v)"></circle>
      </svg>

      <div class="title-card">
        <a class="home" href="/">thesandbox.page</a>
        <h1>Seeing things</h1>
        <p class="lede">
          Ten figures that fool the eye. Five ask you to set a line, a tabletop, a row of tiles, a circle, or a shade
          until it looks right, then measure how far off you were. The other five show you something that isn't there.
        </p>
        <p class="cue">Scroll slowly and watch the disc.</p>
      </div>
    </header>

    <nav class="rail" aria-label="Figures">
      <ol>
        {
          plates.map((p) => (
            <li>
              <a href={`#${p.id}`} data-rail={p.id}>
                <span class="rail-num">{p.num}</span>
                <span class="rail-name">{p.name}</span>
              </a>
            </li>
          ))
        }
        <li>
          <a href="#readings" data-rail="readings">
            <span class="rail-num">&mdash;</span>
            <span class="rail-name">Readings</span>
          </a>
        </li>
      </ol>
    </nav>

    <!-- 01 -->
    <section class="plate" id="fins" data-plate="fins" data-kind="measure" data-state="set" aria-labelledby="fins-name">
      <figure class="figure">
        <svg
          viewBox="0 0 800 600"
          role="img"
          aria-label="Two horizontal lines, one with arrowheads at its ends and one with fins splayed outward."
          data-svg
          set:html={finsFigure(start.fins)}
        />
      </figure>
      <div class="panel">
        <p class="head"><span class="num">01</span><span class="name" id="fins-name">Fins</span><span class="kind">Measure</span></p>
        <p class="instr">Make the lower line as long as the upper one. Judge the lines, not the fins.</p>
        <label class="control">
          <span>Length<em>or drag across the figure</em></span>
          <input type="range" min="220" max="500" step="1" value={start.fins} data-input />
        </label>
        <div class="actions">
          <button class="btn primary" type="button" data-check>Check</button>
          <button class="btn" type="button" data-context hidden aria-pressed="false">Hide the fins</button>
          <button class="btn" type="button" data-again hidden>Again</button>
        </div>
        <p class="result" data-result aria-live="polite"></p>
        <p class="note" data-note hidden>
          The lines were the same length. Fins splayed outward make a line look longer, and arrowheads make it look
          shorter. Franz Müller-Lyer published the figure in 1889, and why it works is still argued over.
        </p>
      </div>
    </section>

    <!-- 02 -->
    <section class="plate" id="grid" data-plate="grid" data-kind="watch" aria-labelledby="grid-name">
      <figure class="figure">
        <svg
          viewBox="0 0 800 600"
          role="img"
          aria-label="Grey bars crossing on black, with a white disc at every crossing."
          data-svg
          set:html={gridFigure(0)}
        />
      </figure>
      <div class="panel">
        <p class="head"><span class="num">02</span><span class="name" id="grid-name">Grid</span><span class="kind">Watch</span></p>
        <p class="instr">
          Let your eyes wander over the grid. Dark dots flicker in the white discs you aren't looking at, and vanish from
          any disc you look at straight on.
        </p>
        <label class="control">
          <span>Bend the bars</span>
          <input type="range" min="0" max="14" step="0.5" value="0" data-input />
        </label>
        <p class="note">
          There are no dark dots. Bending the bars makes them go away, though nothing changes at the discs, which is hard
          to square with the old textbook account of cells in the retina sharpening edges.
        </p>
      </div>
    </section>

    <!-- 03 -->
    <section
      class="plate"
      id="tables"
      data-plate="tables"
      data-kind="measure"
      data-state="set"
      aria-labelledby="tables-name"
    >
      <figure class="figure">
        <svg
          viewBox="0 0 800 600"
          role="img"
          aria-label="Two tables drawn from above, one long and narrow pointing away, one turned sideways."
          data-svg
          set:html={tablesFigure(start.tables)}
        />
      </figure>
      <div class="panel">
        <p class="head">
          <span class="num">03</span><span class="name" id="tables-name">Tables</span><span class="kind">Measure</span>
        </p>
        <p class="instr">Stretch the right tabletop until it is the same shape as the left one.</p>
        <label class="control">
          <span>Length<em>or drag across the figure</em></span>
          <input type="range" min="150" max="380" step="1" value={start.tables} data-input />
        </label>
        <div class="actions">
          <button class="btn primary" type="button" data-check>Check</button>
          <button class="btn" type="button" data-context hidden aria-pressed="false">Hide the legs</button>
          <button class="btn" type="button" data-again hidden>Again</button>
        </div>
        <p class="result" data-result aria-live="polite"></p>
        <p class="note" data-note hidden>
          The two tops were the same shape, one turned a quarter turn. The legs make you see surfaces lying in depth, and
          the eye lengthens the one that seems to point away from you. After Roger Shepard's tables.
        </p>
      </div>
    </section>

    <!-- 04 -->
    <section class="plate" id="chaser" data-plate="chaser" data-kind="watch" data-motion aria-labelledby="chaser-name">
      <figure class="figure">
        <svg
          viewBox="0 0 800 600"
          role="img"
          aria-label="Twelve soft coloured discs in a ring on grey, one missing at a time, round a black cross."
          data-svg
          set:html={chaserFigure()}
        />
      </figure>
      <div class="panel">
        <p class="head">
          <span class="num">04</span><span class="name" id="chaser-name">Chaser</span><span class="kind">Watch</span>
        </p>
        <p class="instr">
          Look at the cross and keep looking for half a minute. The gap becomes a disc of the opposite colour running
          round, and the others fade away.
        </p>
        <fieldset class="swatches">
          <legend>Discs</legend>
          <label><input type="radio" name="seeing-chase" value="#d98ad9" checked data-colour /><span style="--s:#d98ad9">Lilac</span></label>
          <label><input type="radio" name="seeing-chase" value="#3bb7ad" data-colour /><span style="--s:#3bb7ad">Teal</span></label>
          <label><input type="radio" name="seeing-chase" value="#e4be2d" data-colour /><span style="--s:#e4be2d">Gold</span></label>
        </fieldset>
        <label class="control">
          <span>Blur</span>
          <input type="range" min="0" max="22" step="0.5" value="13" data-input />
        </label>
        <div class="actions">
          <button class="btn" type="button" data-play aria-pressed="true">Pause</button>
        </div>
        <p class="note">
          Nothing on the screen is that colour. Each gap leaves an afterimage in the opposite colour, and blurred discs
          you hold still in your gaze fade from view. Sharpen them and they stop fading. Jeremy Hinton made the first one.
        </p>
      </div>
    </section>

    <!-- 05 -->
    <section
      class="plate"
      id="mortar"
      data-plate="mortar"
      data-kind="measure"
      data-state="set"
      aria-labelledby="mortar-name"
    >
      <figure class="figure">
        <svg
          viewBox="0 0 800 600"
          role="img"
          aria-label="Rows of black and white tiles laid like bricks, with grey mortar between the rows."
          data-svg
          set:html={mortarFigure(start.mortar)}
        />
      </figure>
      <div class="panel">
        <p class="head">
          <span class="num">05</span><span class="name" id="mortar-name">Mortar</span><span class="kind">Measure</span>
        </p>
        <p class="instr">The grey lines between the rows look tilted. Tilt them back until they all look level.</p>
        <label class="control">
          <span>Tilt<em>or drag across the figure</em></span>
          <input type="range" min="-3.5" max="3.5" step="0.05" value={start.mortar} data-input />
        </label>
        <div class="actions">
          <button class="btn primary" type="button" data-check>Check</button>
          <button class="btn" type="button" data-context hidden aria-pressed="false">Hide the tiles</button>
          <button class="btn" type="button" data-again hidden>Again</button>
        </div>
        <p class="result" data-result aria-live="polite"></p>
        <p class="note" data-note hidden>
          The lines were level at 0°. The tilt needs mortar of a shade between the dark and light tiles, and goes if the
          contrast does. It is named after the tiled front of a café in Bristol.
        </p>
      </div>
    </section>

    <!-- 06 -->
    <section class="plate" id="buses" data-plate="buses" data-kind="watch" data-motion aria-labelledby="buses-name">
      <figure class="figure">
        <svg
          viewBox="0 0 800 600"
          role="img"
          aria-label="A yellow bar and a blue bar moving across black and white stripes."
          data-svg
          set:html={busesFigure()}
        />
      </figure>
      <div class="panel">
        <p class="head"><span class="num">06</span><span class="name" id="buses-name">Buses</span><span class="kind">Watch</span></p>
        <p class="instr">Watch the two bars cross the stripes. They seem to take turns stepping forward, like feet.</p>
        <label class="control">
          <span>Stripes</span>
          <input type="range" min="0" max="1" step="0.01" value="1" data-input />
        </label>
        <div class="actions">
          <button class="btn" type="button" data-play aria-pressed="true">Pause</button>
        </div>
        <p class="note">
          They move together at one steady speed. A bar looks faster while its ends stand out against the stripes and
          slower while they blend in, and the yellow and blue bars blend in at opposite moments. Fade the stripes and
          they glide. Stuart Anstis's stepping feet.
        </p>
      </div>
    </section>

    <!-- 07 -->
    <section class="plate" id="halo" data-plate="halo" data-kind="measure" data-state="set" aria-labelledby="halo-name">
      <figure class="figure">
        <svg
          viewBox="0 0 800 600"
          role="img"
          aria-label="A disc ringed by large discs beside a disc ringed by small ones."
          data-svg
          set:html={haloFigure(start.halo)}
          style={`--meet-left:${HALO_MEET.left - HALO.left}px;--meet-right:${HALO_MEET.right - HALO.right}px`}
        />
      </figure>
      <div class="panel">
        <p class="head"><span class="num">07</span><span class="name" id="halo-name">Halo</span><span class="kind">Measure</span></p>
        <p class="instr">Size the right centre disc until it matches the left one.</p>
        <label class="control">
          <span>Size<em>or drag across the figure</em></span>
          <input type="range" min="20" max="56" step="0.25" value={start.halo} data-input />
        </label>
        <div class="actions">
          <button class="btn primary" type="button" data-check>Check</button>
          <button class="btn" type="button" data-context hidden aria-pressed="false">Hide the rings</button>
          <button class="btn" type="button" data-again hidden>Again</button>
        </div>
        <p class="result" data-result aria-live="polite"></p>
        <p class="note" data-note hidden>
          They were the same size. Among large discs a disc looks smaller, and among small ones it looks larger. Hermann
          Ebbinghaus's figure, made famous by Edward Titchener.
        </p>
      </div>
    </section>

    <!-- 08 -->
    <section class="plate" id="spiral" data-plate="spiral" data-kind="watch" aria-labelledby="spiral-name">
      <figure class="figure">
        <svg
          viewBox="0 0 800 600"
          role="img"
          aria-label="A black and white spiral with a red dot at its centre."
          data-svg
          set:html={spiralFigure()}
        />
      </figure>
      <div class="panel">
        <p class="head">
          <span class="num">08</span><span class="name" id="spiral-name">Spiral</span><span class="kind">Watch</span>
        </p>
        <p class="instr" data-spiral-say>
          Press start and keep your eyes on the red dot while the spiral turns. When it stops, keep looking.
        </p>
        <fieldset class="swatches toggles">
          <legend>Turning</legend>
          <label><input type="radio" name="seeing-spin" value="out" checked data-dir /><span>Outward</span></label>
          <label><input type="radio" name="seeing-spin" value="in" data-dir /><span>Inward</span></label>
        </fieldset>
        <div class="actions">
          <button class="btn primary" type="button" data-start>Start · 20 s</button>
        </div>
        <p class="note">
          Once it stops, the still spiral seems to flow the other way, and so does whatever you look at next. Cells that
          answer to one direction of motion tire while you stare, and those tuned the other way win for a while. Robert
          Addams described it in 1834, after watching a waterfall.
        </p>
      </div>
    </section>

    <!-- 09 -->
    <section
      class="plate"
      id="stripes"
      data-plate="stripes"
      data-kind="measure"
      data-state="set"
      aria-labelledby="stripes-name"
    >
      <figure class="figure">
        <svg
          viewBox="0 0 800 600"
          role="img"
          aria-label="Black and white stripes with grey bars set into the black stripes on the left and the white stripes on the right."
          data-svg
          set:html={stripesFigure(start.stripes)}
        />
      </figure>
      <div class="panel">
        <p class="head">
          <span class="num">09</span><span class="name" id="stripes-name">Stripes</span><span class="kind">Measure</span>
        </p>
        <p class="instr">Set the grey of the right bars to match the left bars.</p>
        <label class="control">
          <span>Grey<em>or drag across the figure</em></span>
          <input type="range" min="70" max="190" step="1" value={start.stripes} data-input />
        </label>
        <div class="actions">
          <button class="btn primary" type="button" data-check>Check</button>
          <button class="btn" type="button" data-context hidden aria-pressed="false">Hide the stripes</button>
          <button class="btn" type="button" data-again hidden>Again</button>
        </div>
        <p class="result" data-result aria-live="polite"></p>
        <p class="note" data-note hidden>
          The two greys were the same. Which way the stripes push a bar depends on whether it lies in a black stripe or a
          white one, and why is still argued over. Michael White described it in 1979.
        </p>
      </div>
    </section>

    <!-- 10 -->
    <section class="plate" id="drift" data-plate="drift" data-kind="watch" aria-labelledby="drift-name">
      <figure class="figure">
        <svg
          viewBox="0 0 800 600"
          role="img"
          aria-label="Six wheels of rings stepped black, blue, white, and yellow."
          data-svg
          set:html={driftFigure()}
        />
      </figure>
      <div class="panel">
        <p class="head"><span class="num">10</span><span class="name" id="drift-name">Drift</span><span class="kind">Watch</span></p>
        <p class="instr">Let your eyes roam over the wheels. They seem to turn, though the picture is still.</p>
        <label class="control">
          <span>Contrast</span>
          <input type="range" min="0" max="1" step="0.01" value="1" data-input />
        </label>
        <div class="actions">
          <button class="btn" type="button" data-grey aria-pressed="false">Grey</button>
          <button class="btn" type="button" data-reverse aria-pressed="false">Reverse</button>
        </div>
        <p class="note">
          Each ring repeats black, dark, white, light. Out of the corner of the eye the pattern seems to creep from black
          toward dark and from white toward light, so reversing the order reverses the turn. Alan Fraser and Kimberley
          Wilcox found the effect in 1979; Akiyoshi Kitaoka made it famous in colour.
        </p>
      </div>
    </section>

    <section class="readings" id="readings" aria-labelledby="readings-title">
      <h2 id="readings-title">Your readings</h2>
      <p class="readings-lede" data-readings-lede>
        Set the five measured figures and your readings collect here. Zero is the truth.
      </p>
      <table>
        <thead>
          <tr><th scope="col">Figure</th><th scope="col">You</th><th scope="col" class="scale-head">Off by</th><th
              scope="col">Last time</th></tr>
        </thead>
        <tbody>
          {
            [
              { id: 'fins', label: '01 Fins' },
              { id: 'tables', label: '03 Tables' },
              { id: 'mortar', label: '05 Mortar' },
              { id: 'halo', label: '07 Halo' },
              { id: 'stripes', label: '09 Stripes' },
            ].map((r) => (
              <tr data-reading={r.id}>
                <th scope="row">
                  <a href={`#${r.id}`}>{r.label}</a>
                </th>
                <td data-now>Not set</td>
                <td class="scale">
                  <span class="bar" data-bar />
                </td>
                <td data-last>&mdash;</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <footer class="colophon">
        <p>
          Figures drawn for this page after Franz Müller-Lyer, Elke Lingelbach, Roger Shepard, Jeremy Hinton, Richard
          Gregory and Priscilla Heard, Stuart Anstis, Hermann Ebbinghaus, Robert Addams, Michael White, Alan Fraser and
          Kimberley Wilcox, Akiyoshi Kitaoka, and Hajime Ouchi.
        </p>
        <p><a href="/">thesandbox.page</a></p>
      </footer>
    </section>
  </main>
</Bare>

<script>
  import './_app';
</script>

<style>
  .seeing {
    --paper: #efebe2;
    --card: #fbfaf6;
    --ink: #16130f;
    --red: #e2412b;
    --mute: #6c675e;
    --rule: rgb(22 19 15 / 0.14);
    --cobalt: #2747c8;
    --ochre: #e3a32a;
    font-family: var(--font-seeing);
    font-size: 17px;
    line-height: 1.5;
    color: var(--ink);
    background: var(--paper);
    -webkit-font-smoothing: antialiased;
  }

  :global(html:has(.seeing)) {
    scroll-snap-type: y proximity;
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html:has(.seeing)) {
      scroll-behavior: auto;
    }
  }
  :global(body:has(.seeing)) {
    margin: 0;
    background: #efebe2;
  }
  .seeing *,
  .seeing *::before,
  .seeing *::after {
    box-sizing: border-box;
  }

  /* ---------------------------------------------------------- opener */

  .opener {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    padding: clamp(16px, 4vw, 56px);
    overflow: clip;
    scroll-snap-align: start;
  }
  .ouchi {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  .ouchi-disc {
    cx: 70%;
    cy: 44%;
    r: min(30vmin, 300px);
  }
  @media (max-width: 860px) {
    .ouchi-disc {
      cx: 50%;
      cy: 22%;
      r: min(36vw, 26vh);
    }
  }
  .title-card {
    position: relative;
    max-width: 640px;
    padding: 28px 32px 30px;
    background: var(--paper);
    box-shadow: 0 0 0 2px var(--ink);
  }
  .home {
    display: inline-block;
    margin-bottom: 18px;
    font-size: 12px;
    font-weight: 700;
    font-stretch: 125%;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid var(--red);
  }
  h1 {
    margin: 0;
    font-size: clamp(54px, 9vw, 128px);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 0.86;
    letter-spacing: -0.035em;
  }
  .lede {
    margin: 22px 0 0;
    max-width: 52ch;
    font-size: 18px;
  }
  .cue {
    margin: 16px 0 0;
    font-size: 13px;
    font-weight: 700;
    font-stretch: 125%;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--red);
  }

  /* ---------------------------------------------------------- rail */

  .rail {
    position: fixed;
    left: 22px;
    top: 50%;
    z-index: 2;
    translate: 0 -50%;
    display: none;
    transition: opacity 0.3s;
  }
  .seeing[data-opener] .rail {
    opacity: 0;
    pointer-events: none;
  }
  .rail ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 2px;
  }
  .rail a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 3px 0;
    color: var(--mute);
    text-decoration: none;
    font-size: 11px;
    font-weight: 600;
    font-stretch: 125%;
    letter-spacing: 0.08em;
  }
  .rail .rail-num {
    width: 22px;
    font-variant-numeric: tabular-nums;
  }
  .rail .rail-name {
    opacity: 0;
    text-transform: uppercase;
    transition: opacity 0.2s;
  }
  .rail:hover .rail-name,
  .rail a:focus-visible .rail-name,
  .rail a[aria-current='true'] .rail-name {
    opacity: 1;
  }
  .rail a[aria-current='true'] {
    color: var(--ink);
  }
  .rail a {
    position: relative;
  }
  .rail a[data-done]::after {
    content: '';
    position: absolute;
    left: -11px;
    top: calc(50% - 3px);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--red);
  }
  .rail a:focus-visible {
    outline: 2px solid var(--red);
    outline-offset: 2px;
  }
  @media (min-width: 1180px) {
    .rail {
      display: block;
    }
  }

  /* ---------------------------------------------------------- plates */

  .plate {
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
    gap: clamp(32px, 4vw, 64px);
    align-items: center;
    padding: 56px clamp(16px, 5vw, 80px);
    border-top: 1px solid var(--rule);
    scroll-snap-align: start;
  }
  @media (min-width: 1180px) {
    .plate {
      padding-left: 150px;
    }
  }
  .figure {
    margin: 0;
    justify-self: center;
    width: min(100%, calc((100svh - 112px) * 4 / 3));
    aspect-ratio: 4 / 3;
  }
  .figure svg {
    display: block;
    width: 100%;
    height: 100%;
    box-shadow: 0 1px 0 var(--rule);
  }

  .panel {
    align-self: center;
  }
  .head {
    margin: 0 0 18px;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: end;
    column-gap: 14px;
  }
  .num {
    grid-row: span 2;
    font-size: clamp(64px, 7vw, 104px);
    font-weight: 200;
    font-stretch: 125%;
    line-height: 0.8;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }
  .name {
    font-size: 22px;
    font-weight: 800;
    font-stretch: 125%;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .kind {
    justify-self: start;
    margin-top: 6px;
    font-size: 11px;
    font-weight: 700;
    font-stretch: 125%;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute);
  }
  [data-kind='measure'] .kind {
    color: var(--red);
  }
  .instr {
    margin: 0 0 20px;
    font-size: 18px;
  }
  .note {
    margin: 18px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    font-size: 15px;
    color: var(--mute);
  }

  .control {
    display: grid;
    gap: 4px;
    margin: 0 0 16px;
  }
  .control > span {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .control em {
    font-style: normal;
    font-weight: 500;
    font-stretch: 100%;
    letter-spacing: 0;
    text-transform: none;
    font-size: 12px;
  }
  [data-kind='measure'][data-state='set'] .figure svg {
    cursor: ew-resize;
    touch-action: pan-y;
  }
  .control > span,
  .swatches legend {
    font-size: 11px;
    font-weight: 700;
    font-stretch: 125%;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute);
  }
  input[type='range'] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 30px;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }
  input[type='range']::-webkit-slider-runnable-track {
    height: 2px;
    background: var(--ink);
  }
  input[type='range']::-moz-range-track {
    height: 2px;
    background: var(--ink);
  }
  input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 22px;
    height: 22px;
    margin-top: -10px;
    border-radius: 50%;
    background: var(--card);
    border: 2px solid var(--ink);
  }
  input[type='range']::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--card);
    border: 2px solid var(--ink);
  }
  input[type='range']:focus-visible {
    outline: none;
  }
  input[type='range']:focus-visible::-webkit-slider-thumb {
    box-shadow: 0 0 0 3px var(--red);
  }
  input[type='range']:focus-visible::-moz-range-thumb {
    box-shadow: 0 0 0 3px var(--red);
  }
  input[type='range']:disabled {
    cursor: default;
    opacity: 0.35;
  }

  .swatches {
    margin: 0 0 16px;
    padding: 0;
    border: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .swatches legend {
    padding: 0;
    margin-bottom: 8px;
  }
  .swatches label {
    position: relative;
  }
  .swatches input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .swatches span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border: 2px solid var(--rule);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 600;
  }
  .swatches span[style]::before {
    content: '';
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--s);
  }
  .swatches input:checked + span {
    border-color: var(--ink);
  }
  .swatches input:focus-visible + span {
    box-shadow: 0 0 0 3px var(--red);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .btn {
    padding: 11px 16px 10px;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-family: var(--font-seeing);
    font-size: 12px;
    font-weight: 700;
    font-stretch: 125%;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .btn:hover {
    background: rgb(22 19 15 / 0.06);
  }
  .btn.primary {
    background: var(--ink);
    color: var(--card);
  }
  .btn.primary:hover {
    background: #2d2923;
  }
  .btn:focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 2px;
  }
  .btn[aria-pressed='true'] {
    background: var(--ink);
    color: var(--card);
  }
  [hidden] {
    display: none !important;
  }

  .result {
    margin: 18px 0 0;
    min-height: 1.4em;
    font-size: 22px;
    font-weight: 700;
    font-stretch: 112%;
    line-height: 1.25;
  }
  .result:empty {
    display: none;
  }

  @media (max-width: 860px) {
    .plate {
      grid-template-columns: minmax(0, 1fr);
      min-height: auto;
      gap: 20px;
      padding: 36px 16px 48px;
    }
    .figure {
      width: 100%;
    }
    .head {
      margin-bottom: 12px;
    }
    .instr {
      font-size: 17px;
    }
  }

  /* ---------------------------------------------------------- readings */

  .readings {
    min-height: 100svh;
    padding: 72px clamp(16px, 5vw, 80px) 48px;
    border-top: 1px solid var(--rule);
    scroll-snap-align: start;
    display: grid;
    align-content: start;
  }
  @media (min-width: 1180px) {
    .readings {
      padding-left: 150px;
    }
  }
  h2 {
    margin: 0;
    font-size: clamp(40px, 6vw, 84px);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .readings-lede {
    margin: 18px 0 28px;
    max-width: 56ch;
  }
  table {
    width: 100%;
    max-width: 900px;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  th,
  td {
    padding: 14px 12px 14px 0;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: middle;
  }
  thead th {
    font-size: 11px;
    font-weight: 700;
    font-stretch: 125%;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute);
  }
  tbody th {
    font-weight: 800;
    font-stretch: 125%;
  }
  tbody th a {
    color: inherit;
    text-decoration: none;
  }
  tbody th a:hover {
    text-decoration: underline;
    text-decoration-color: var(--red);
  }
  td[data-now] {
    font-weight: 700;
  }
  td[data-last] {
    color: var(--mute);
  }
  .scale {
    width: 34%;
  }
  .bar {
    position: relative;
    display: block;
    height: 18px;
    background: linear-gradient(var(--red), var(--red)) 50% 0 / 2px 100% no-repeat;
  }
  .bar::after {
    content: '';
    position: absolute;
    top: 5px;
    height: 8px;
    left: var(--left, 50%);
    width: var(--width, 0%);
    background: var(--ink);
  }
  .colophon {
    margin-top: 56px;
    max-width: 70ch;
    font-size: 14px;
    color: var(--mute);
  }
  .colophon a {
    color: var(--ink);
    font-weight: 700;
    font-stretch: 125%;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-size: 12px;
    text-decoration-color: var(--red);
    text-underline-offset: 4px;
  }
  @media (max-width: 860px) {
    .readings {
      min-height: auto;
      padding: 48px 16px 40px;
    }
    table {
      font-size: 15px;
    }
    th,
    td {
      padding: 12px 8px 12px 0;
      white-space: nowrap;
    }
    tbody th {
      font-stretch: 100%;
    }
    .scale {
      width: 20%;
    }
  }
</style>

<style is:global>
  /* Figure parts are drawn from strings at build time and by script, so they carry no scope; every rule sits under the page root. */
  .seeing .card {
    fill: #fbfaf6;
  }
  .seeing .ctx {
    transition: opacity 0.7s ease;
  }
  .seeing [data-context='off'] .ctx {
    opacity: 0.08;
  }
  .seeing [data-truth] > * {
    animation: seeing-in 0.7s ease both;
  }
  .seeing [data-truth] .guide {
    fill: none;
    stroke: #e2412b;
    stroke-width: 2;
    stroke-dasharray: 7 7;
  }
  .seeing [data-truth] .error {
    fill: none;
    stroke: #e2412b;
    stroke-width: 9;
    stroke-linecap: butt;
  }
  .seeing [data-truth] .tick {
    fill: none;
    stroke: #e2412b;
    stroke-width: 3;
  }
  @keyframes seeing-in {
    from {
      opacity: 0;
    }
  }

  /* Fins */
  .seeing .ink-lines path {
    fill: none;
    stroke: #16130f;
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Grid */
  .seeing .dark {
    fill: #0d0c0b;
  }
  .seeing .grid-bars {
    fill: none;
    stroke: #7d7c78;
    stroke-width: 9;
  }
  .seeing .grid-discs {
    fill: #ffffff;
  }

  /* Tables */
  .seeing .table .legs {
    fill: #16130f;
  }
  .seeing .table .edges {
    fill: #182a75;
  }
  .seeing .table .top {
    fill: #2747c8;
    stroke: #16130f;
    stroke-width: 3;
    stroke-linejoin: round;
  }
  .seeing [data-truth] .outline {
    fill: none;
    stroke: #16130f;
    stroke-width: 2;
    stroke-dasharray: 5 6;
  }
  .seeing [data-truth] .turned {
    fill: rgb(226 65 43 / 0.16);
    stroke: #e2412b;
    stroke-width: 4;
    stroke-linejoin: round;
    transform-box: view-box;
    animation:
