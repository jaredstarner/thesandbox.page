---
import { Font } from 'astro:assets';
import Bare from '../../layouts/Bare.astro';
import { GLASSES, swatch } from './_spectra';
import { PRESETS } from './_presets';

const description =
  "A sign shop's window on a wet night: letter a sign, fill its tubes with neon, helium, or argon and mercury, flip the switch, and look at it through a diffraction grating.";

const glasses = GLASSES.map((g) => ({ id: g.id, name: g.name, colour: swatch(g) }));
const lines = [
  { n: 0, label: 'First line' },
  { n: 1, label: 'Second line' },
];
const styles = [
  { id: 'script', label: 'Script' },
  { id: 'sans', label: 'Sans' },
  { id: 'square', label: 'Square' },
];
---

<Bare title="Neon" description={description}>
  <Font cssVariable="--font-neon-print" slot="head" />
  <Font cssVariable="--font-neon-type" slot="head" />
  <main class="neon" data-neon>
    <div class="stage" data-stage>
      <canvas class="scene" data-scene aria-label="A shop window at night with a neon sign hung inside it"></canvas>
      <div class="mount" data-mount hidden aria-hidden="true">
        <span>Diffraction grating</span>
      </div>
      <p class="hint" data-hint>
        <span class="fine">Click a tube to see the light it gives off.</span>
        <span class="coarse">Tap a tube to see the light it gives off.</span>
      </p>
      <p class="pen-hint" data-pen-hint hidden>Draw on the glass. Each stroke becomes a tube.</p>
      <p class="fallback" data-fallback hidden>
        This window needs WebGL 2 to light up, and this browser didn't offer it.
      </p>
    </div>

    <aside class="docket" aria-label="Work order">
      <header class="masthead">
        <p class="home"><a href="/">thesandbox.page</a></p>
        <h1>Neon</h1>
        <p class="dek">A sign shop's window on a wet night.</p>
      </header>
      <section class="ticket">
        <header class="ticket-head">
          <p class="shop">Neon signs &middot; Glass bent to order</p>
          <h2>Work order</h2>
        </header>

        {
          lines.map((l) => (
            <div class="line" data-line={l.n}>
              <label class="lbl" for={`neon-words-${l.n}`}>
                {l.label}
              </label>
              <input
                id={`neon-words-${l.n}`}
                class="words"
                data-text
                maxlength="18"
                spellcheck="false"
                autocomplete="off"
              />
              <div class="opts">
                <div class="styles" role="group" aria-label={`Lettering for the ${l.label.toLowerCase()}`}>
                  {styles.map((s) => (
                    <button type="button" class="style" data-style={s.id} aria-pressed="false">
                      {s.label}
                    </button>
                  ))}
                </div>
                <select class="glass" data-glass aria-label={`Glass for the ${l.label.toLowerCase()}`}>
                  <button type="button">
                    <selectedcontent />
                  </button>
                  {glasses.map((g) => (
                    <option value={g.id}>
                      <span class="sw" style={`--sw: ${g.colour}`} />
                      <span class="nm">{g.name}</span>
                    </option>
                  ))}
                </select>
              </div>
            </div>
          ))
        }

        <div class="pen">
          <p class="lbl">Freehand</p>
          <div class="pen-row">
            <button type="button" class="ink" data-draw aria-pressed="false">Draw on the glass</button>
            <select class="glass" data-pen-glass aria-label="Glass for freehand tubes">
              <button type="button">
                <selectedcontent />
              </button>
              {
                glasses.map((g) => (
                  <option value={g.id}>
                    <span class="sw" style={`--sw: ${g.colour}`} />
                    <span class="nm">{g.name}</span>
                  </option>
                ))
              }
            </select>
          </div>
          <div class="pen-row small">
            <button type="button" class="plain" data-undo disabled>Undo stroke</button>
            <button type="button" class="plain" data-clear disabled>Clear freehand</button>
          </div>
        </div>

        <dl class="tally">
          <div><dt>Glass</dt><dd data-tally="glass">0.0 m</dd></div>
          <div><dt>Tubes</dt><dd data-tally="units">0</dd></div>
          <div><dt>Jumps, blacked out</dt><dd data-tally="jumps">0</dd></div>
          <div><dt>Electrodes</dt><dd data-tally="electrodes">0</dd></div>
        </dl>

        <div class="book">
          <p class="lbl">From the pattern book</p>
          <div class="presets">
            {
              PRESETS.map((p, i) => (
                <button type="button" class="preset" data-preset={i}>
                  {p.name}
                </button>
              ))
            }
          </div>
        </div>
      </section>

      <section class="board" aria-label="Controls">
        <button type="button" class="switch" data-switch aria-pressed="false">
          <span class="plate" aria-hidden="true"><span class="lever"></span></span>
          <span class="switch-label">Sign <b data-switch-word>off</b></span>
        </button>
        <div class="chips">
          <button type="button" class="chip" data-grating aria-pressed="false">Hold up a grating</button>
          <button type="button" class="chip" data-closer aria-pressed="false">Step closer</button>
          <button type="button" class="chip" data-rain aria-pressed="true">Rain</button>
          <button type="button" class="chip" data-sound aria-pressed="true">Sound</button>
        </div>
        <label class="spread" data-spread-wrap hidden>
          <span>Grating, near to far</span>
          <input type="range" data-spread min="0.04" max="0.3" step="0.005" value="0.16" />
        </label>
      </section>

      <section class="spectrum" aria-labelledby="neon-spectrum-title">
        <h2 id="neon-spectrum-title">What the tube gives off</h2>
        <div class="pick" data-spec-pick role="group" aria-label="Glass shown"></div>
        <canvas class="strip" data-spectrum aria-label="Emission spectrum of the chosen tube"></canvas>
        <p class="note" data-spec-note></p>
        <p class="how">
          Every colour in the window is worked out from this: the wavelengths the gas shines at, filtered by the glass or
          spread by the powder on it, added up the way the eye adds them.
        </p>
      </section>

      <footer class="colophon">
        <p>
          Lettering from EMS Allure, EMS Readability, and EMS Osmotron, single-line fonts by Sheldon B. Michaels after
          Allura, Source Sans Pro, and Orbitron, under the SIL Open Font License.
        </p>
      </footer>
    </aside>
  </main>
</Bare>

<script>
  import { start } from './_main';

  const root = document.querySelector<HTMLElement>('[data-neon]');
  if (root) start(root);
</script>

<style>
  :global(body:has(.neon)) {
    margin: 0;
    background: #07080b;
  }

  .neon {
    --print: var(--font-neon-print), 'Arial Narrow', sans-serif;
    --type: var(--font-neon-type), ui-monospace, monospace;
    --panel: 400px;
    --paper: #ece3cd;
    --paper-edge: #d9ceb4;
    --ink: #1f1c18;
    --rule: #b5372c;
    --blue-rule: #9fb3c2;
    --board: #121315;
    position: relative;
    min-height: 100svh;
    color: #e9e1cf;
    font-family: var(--type);
    font-size: 14px;
    line-height: 1.45;
  }

  .neon *,
  .neon *::before,
  .neon *::after {
    box-sizing: border-box;
  }

  .neon [hidden] {
    display: none !important;
  }

  .stage {
    position: fixed;
    inset: 0;
  }

  .scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: manipulation;
  }

  .neon[data-drawing='true'] .scene {
    cursor: crosshair;
    touch-action: none;
  }

  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 12px;
    margin: 0 0 18px;
  }

  .masthead a {
    color: #b9b1a0;
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  .masthead a:hover,
  .masthead a:focus-visible {
    color: #fff;
    text-decoration: underline;
  }

  .home {
    flex-basis: 100%;
    margin: 0;
  }

  .masthead h1 {
    margin: 0;
    font: 700 44px/0.95 var(--print);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #efe6d2;
  }

  .dek {
    margin: 0;
    color: #b9b1a0;
    font-size: 13px;
  }

  .hint,
  .pen-hint {
    position: absolute;
    left: 24px;
    bottom: 18px;
    margin: 0;
    max-width: 26em;
    color: #a9a293;
    font-size: 12px;
    text-shadow: 0 1px 6px #000;
    pointer-events: none;
  }

  .pen-hint {
    color: #efe6d2;
  }

  .coarse {
    display: none;
  }

  @media (pointer: coarse) {
    .fine {
      display: none;
    }
    .coarse {
      display: inline;
    }
  }

  .fallback {
    position: absolute;
    inset: 40% 10% auto;
    margin: 0;
    text-align: center;
    color: #efe6d2;
  }

  .mount {
    position: absolute;
    inset: 26px;
    right: calc(var(--panel) + 26px);
    pointer-events: none;
    border-radius: 28px;
    box-shadow:
      0 0 0 26px #191612,
      0 0 0 27px #2a251e,
      inset 0 0 40px 10px rgb(0 0 0 / 70%),
      0 0 0 100vmax #0b0a09;
  }

  .mount span {
    position: absolute;
    left: 50%;
    bottom: -21px;
    transform: translateX(-50%);
    font: 600 12px/1 var(--print);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: #8f8473;
    white-space: nowrap;
  }

  /* The panel. */
  .docket {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--panel);
    overflow-y: auto;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 55%), transparent 14px),
      repeating-linear-gradient(0deg, rgb(255 255 255 / 1.2%) 0 2px, transparent 2px 5px),
      var(--board);
    padding: 18px 18px 28px;
    scrollbar-color: #3a3833 transparent;
  }

  .ticket {
    position: relative;
    background:
      repeating-linear-gradient(180deg, transparent 0 27px, var(--blue-rule) 27px 28px) 0 64px / 100% calc(100% - 64px)
        no-repeat,
      linear-gradient(90deg, transparent 30px, rgb(181 55 44 / 55%) 30px 31px, transparent 31px),
      var(--paper);
    color: var(--ink);
    padding: 16px 16px 18px 42px;
    border-radius: 2px;
    box-shadow:
      0 1px 0 var(--paper-edge),
      0 10px 24px rgb(0 0 0 / 45%);
  }

  .ticket::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 50%;
    width: 64px;
    height: 16px;
    transform: translateX(-50%) rotate(-1.5deg);
    background: rgb(214 205 178 / 78%);
    box-shadow: 0 1px 2px rgb(0 0 0 / 25%);
  }

  .ticket-head {
    border-bottom: 2px solid var(--rule);
    margin: 0 0 12px;
    padding-bottom: 6px;
  }

  .shop {
    margin: 0;
    font: 600 11px/1.2 var(--print);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rule);
  }

  .ticket-head h2 {
    margin: 2px 0 0;
    font: 800 30px/1 var(--print);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .lbl {
    display: block;
    margin: 0 0 4px;
    font: 600 11px/1.2 var(--print);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #6d6355;
  }

  .line {
    margin-bottom: 16px;
  }

  .words {
    width: 100%;
    border: 0;
    border-bottom: 1.5px solid #4a443b;
    background: transparent;
    font: 700 19px/1.4 var(--type);
    color: #191714;
    padding: 2px 2px;
    outline: none;
  }

  .words:focus-visible {
    border-bottom-color: var(--rule);
    background: rgb(255 255 255 / 30%);
  }

  .opts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 8px;
    align-items: center;
  }

  .styles {
    display: flex;
    border: 1.5px solid #4a443b;
    border-radius: 3px;
    overflow: hidden;
  }

  .style {
    font: 600 12px/1 var(--type);
    border: 0;
    border-right: 1px solid #4a443b;
    background: transparent;
    color: #3a352e;
    padding: 6px 8px;
    cursor: pointer;
  }

  .style:last-child {
    border-right: 0;
  }

  .style[aria-pressed='true'] {
    background: #262320;
    color: var(--paper);
  }

  .style:focus-visible,
  .ink:focus-visible,
  .plain:focus-visible,
  .preset:focus-visible,
  .glass:focus-visible {
    outline: 2px solid var(--rule);
    outline-offset: 2px;
  }

  .glass {
    flex: 1 1 150px;
    min-width: 0;
    font: 600 12px/1.2 var(--type);
    color: #2a2622;
    background: rgb(255 255 255 / 35%);
    border: 1.5px solid #4a443b;
    border-radius: 3px;
    padding: 5px 6px;
    cursor: pointer;
  }

  @supports (appearance: base-select) {
    .glass,
    .glass::picker(select) {
      appearance: base-select;
    }

    .glass {
      display: flex;
      align-items: center;
    }

    .glass > button {
      display: flex;
      align-items: center;
      gap: 6px;
      width: 100%;
      font: inherit;
      color: inherit;
      background: none;
      border: 0;
      padding: 0;
      cursor: pointer;
    }

    .glass::picker(select) {
      border: 1px solid #2a2724;
      border-radius: 4px;
      background: #141414;
      color: #e9e1cf;
      padding: 4px;
      box-shadow: 0 12px 30px rgb(0 0 0 / 60%);
    }

    .glass option {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 8px;
      border-radius: 3px;
      font: 600 12px/1.2 var(--type);
    }

    .glass option:hover,
    .glass option:focus-visible {
      background: #26241f;
    }

    .glass option::checkmark {
      order: 3;
      margin-left: auto;
      color: #d6c9a8;
    }

    .glass selectedcontent {
      display: flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
    }

    .sw {
      display: inline-block;
      flex: none;
      width: 26px;
      height: 7px;
      border-radius: 4px;
      background: var(--sw);
      box-shadow:
        0 0 6px 1px var(--sw),
        inset 0 1px 1px rgb(255 255 255 / 70%);
    }

    .glass > button .sw {
      box-shadow:
        0 0 0 1px rgb(0 0 0 / 35%),
        inset 0 1px 1px rgb(255 255 255 / 60%);
    }
  }

  .pen {
    margin: 4px 0 14px;
  }

  .pen-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }

  .pen-row.small {
    margin-top: 6px;
  }

  .ink,
  .plain {
    font: 600 12px/1 var(--type);
    border: 1.5px solid #4a443b;
    border-radius: 3px;
    background: transparent;
    color: #2a2622;
    padding: 7px 9px;
    cursor: pointer;
  }

  .ink[aria-pressed='true'] {
    background: #262320;
    color: var(--paper);
  }

  .plain {
    border-style: dashed;
    padding: 5px 8px;
  }

  .plain:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .tally {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 14px;
    margin: 0 0 14px;
    padding: 8px 0;
    border-top: 1.5px solid #4a443b;
    border-bottom: 1.5px solid #4a443b;
  }

  .tally div {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }

  .tally dt {
    font: 600 11px/1.5 var(--print);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6d6355;
  }

  .tally dd {
    margin: 0;
    font: 700 13px/1.5 var(--type);
    font-variant-numeric: tabular-nums;
  }

  .presets {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .preset {
    font: 600 12px/1 var(--type);
    border: 0;
    border-radius: 2px;
    background: #2a2622;
    color: var(--paper);
    padding: 7px 9px;
    cursor: pointer;
  }

  .preset:hover {
    background: var(--rule);
  }

  /* The switch board. */
  .board {
    margin-top: 18px;
    padding: 14px;
    border-radius: 6px;
    background: radial-gradient(120% 140% at 30% 0%, #2a2724, #141312 60%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 6%),
      0 6px 18px rgb(0 0 0 / 50%);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px 14px;
    align-items: center;
  }

  .switch {
    display: flex;
    align-items: center;
    gap: 10px;
    border: 0;
    background: none;
    color: #e9e1cf;
    cursor: pointer;
    padding: 0;
    font: inherit;
  }

  .plate {
    position: relative;
    width: 46px;
    height: 70px;
    border-radius: 6px;
    background: linear-gradient(160deg, #3a3631, #1c1a17);
    box-shadow:
      inset 0 1px 1px rgb(255 255 255 / 12%),
      0 3px 8px rgb(0 0 0 / 60%);
  }

  .plate::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 30px;
    transform: translate(-50%, -50%);
    border-radius: 4px;
    background: #0c0b0a;
    box-shadow: inset 0 1px 3px #000;
  }

  .lever {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 26px;
    border-radius: 6px;
    background: linear-gradient(90deg, #ece6d6, #b9b1a0 60%, #8d867a);
    box-shadow: 0 2px 3px rgb(0 0 0 / 60%);
    transform: translate(-50%, -4px) perspective(60px) rotateX(-35deg);
    transform-origin: 50% 100%;
    transition: transform 120ms ease;
  }

  .switch[aria-pressed='true'] .lever {
    transform: translate(-50%, -22px) perspective(60px) rotateX(35deg);
    transform-origin: 50% 100%;
  }

  .switch-label {
    font: 700 22px/1 var(--print);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .switch-label b {
    color: #8f8778;
  }

  .switch[aria-pressed='true'] .switch-label b {
    color: #ffb36b;
    text-shadow: 0 0 10px rgb(255 120 40 / 70%);
  }

  .switch:focus-visible .plate {
    outline: 2px solid #e9e1cf;
    outline-offset: 3px;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: flex-end;
  }

  .chip {
    font: 600 12px/1 var(--type);
    border: 1px solid #4b4740;
    border-radius: 999px;
    background: #1b1a18;
    color: #cfc7b6;
    padding: 7px 11px;
    cursor: pointer;
  }

  .chip[aria-pressed='true'] {
    background: #e9e1cf;
    color: #161513;
    border-color: #e9e1cf;
  }

  .chip:focus-visible {
    outline: 2px solid #e9e1cf;
    outline-offset: 2px;
  }

  .spread {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    color: #b9b1a0;
  }

  .spread input {
    flex: 1;
    accent-color: #d6c9a8;
  }

  .spectrum {
    margin-top: 18px;
  }

  .spectrum h2 {
    margin: 0 0 8px;
    font: 700 18px/1 var(--print);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #e9e1cf;
  }

  .pick {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 8px;
  }

  .pick :global(button) {
    display: flex;
    align-items: center;
    gap: 6px;
    font: 600 11px/1 var(--type);
    border: 1px solid #3c3934;
    border-radius: 3px;
    background: #171614;
    color: #bdb5a4;
    padding: 6px 8px;
    cursor: pointer;
  }

  .pick :global(button[aria-pressed='true']) {
    border-color: #d6c9a8;
    color: #f2ead8;
  }

  .pick :global(.dot) {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--sw);
    box-shadow: 0 0 6px var(--sw);
  }

  .strip {
    display: block;
    width: 100%;
    height: 92px;
    border-radius: 3px;
    background: #050505;
  }

  .note,
  .how {
    margin: 8px 0 0;
    font-size: 12.5px;
    color: #c9c1b0;
  }

  .how {
    color: #8f887a;
  }

  .colophon {
    margin-top: 20px;
    font-size: 11px;
    color: #6f695f;
  }

  .colophon p {
    margin: 0;
  }

  /* Phones and narrow windows: the scene on top, the work order underneath. */
  @media (max-width: 899px) {
    .neon {
      --panel: 0px;
    }

    .stage {
      position: sticky;
      top: 0;
      height: 58svh;
      z-index: 1;
    }

    .hint,
    .pen-hint {
      left: 14px;
      bottom: 10px;
    }

    .mount {
      inset: 14px;
      border-radius: 18px;
      box-shadow:
        0 0 0 14px #191612,
        inset 0 0 30px 8px rgb(0 0 0 / 70%),
        0 0 0 100vmax #0b0a09;
    }

    .mount span {
      bottom: -13px;
      font-size: 10px;
    }

    .docket {
      position: relative;
      width: auto;
      z-index: 2;
      padding: 18px 14px 28px;
      box-shadow: 0 -10px 20px rgb(0 0 0 / 50%);
    }
  }
</style>
