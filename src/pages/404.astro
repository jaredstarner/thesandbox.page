---
import Base from '../layouts/Base.astro';
---

<Base title="Washed away" description="This page isn't here.">
  <main>
    <p class="code" aria-hidden="true">404</p>
    <h1>This part of the beach washed away.</h1>
    <p>Whatever was built here is gone, or never was.</p>
    <a href="/">Back to the sand</a>
    <div class="tide" aria-hidden="true"></div>
  </main>
</Base>

<style>
  main {
    position: relative;
    display: grid;
    place-content: center;
    justify-items: center;
    min-height: 100dvh;
    padding: var(--space-3);
    overflow: hidden;
    background: linear-gradient(var(--color-sky-top), var(--color-sky-bottom));
    text-align: center;
  }

  .code {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-display);
    font-weight: 800;
    line-height: 1;
    color: var(--color-sand-title);
  }

  h1 {
    margin: var(--space-3) 0 var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }

  p {
    color: var(--color-muted);
  }

  .tide {
    position: absolute;
    right: -10%;
    bottom: 0;
    left: -10%;
    height: 22vh;
    border-radius: 50% 50% 0 0;
    background: var(--color-sand);
    opacity: 0.85;
    animation: tide 7s ease-in-out infinite alternate;
  }

  @keyframes tide {
    from {
      transform: translateY(35%) rotate(-1.5deg);
    }
    to {
      transform: translateY(12%) rotate(1.5deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tide {
      animation: none;
      transform: translateY(20%);
    }
  }
</style>
