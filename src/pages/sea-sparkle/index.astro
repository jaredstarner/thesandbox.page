---
import { Font } from 'astro:assets';
import Bare from '../../layouts/Bare.astro';
---

<Bare
  title="Sea sparkle"
  description="A tank of glowing plankton behind your screen: drag the window and the water sloshes and lights up blue, or open a second window and pour it across."
>
  <Font cssVariable="--font-seasparkle" slot="head" />

  <main class="sparkle" data-sparkle>
    <canvas class="water" data-water aria-hidden="true"></canvas>
    <div class="marks" data-marks aria-hidden="true"></div>

    <header class="label">
      <a class="home" href="/" title="Back to thesandbox.page">thesandbox.page</a>
      <h1>Sea sparkle</h1>
      <p class="species"><i>Noctiluca scintillans</i> in seawater</p>
      <p class="tank" data-tank>Tank 1</p>
    </header>

    <p class="hint" data-hint aria-live="polite"></p>

    <nav class="controls" aria-label="Tank">
      <button type="button" data-open hidden>Open a second tank</button>
      <button type="button" data-fill>Top up</button>
      <button type="button" data-tilt hidden>Tilt to pour</button>
    </nav>

    <p class="unsupported" data-unsupported hidden>
      This browser can't run the tank: it needs WebGL2 and web workers.
    </p>
    <noscript>
      <p class="unsupported">The tank runs on JavaScript, which is off.</p>
    </noscript>
  </main>
</Bare>

<style>
  .sparkle {
    --enamel: rgb(232 240 246 / 0.86);
    --enamel-dim: rgb(232 240 246 / 0.5);
    --night: #05070b;

    position: fixed;
    inset: 0;
    overflow: hidden;
    background: var(--night);
    color: var(--enamel);
    text-shadow:
      0 0 6px rgb(5 7 11 / 0.9),
      0 0 14px rgb(5 7 11 / 0.7);
    font:
      400 15px/1.35 var(--font-seasparkle),
      Futura,
      Arial,
      sans-serif;
    -webkit-font-smoothing: antialiased;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
  }

  :global(body:has(.sparkle)) {
    margin: 0;
    background: #05070b;
  }

  .water {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .marks {
    position: absolute;
    inset: 0 auto 0 0;
    width: 60px;
    pointer-events: none;
  }

  .marks :global(i) {
    position: absolute;
    left: 0;
    width: 9px;
    height: 1px;
    background: rgb(232 240 246 / 0.28);
  }

  .marks :global(i.major) {
    width: 16px;
    background: rgb(232 240 246 / 0.45);
  }

  .marks :global(b) {
    position: absolute;
    left: 21px;
    transform: translateY(50%);
    color: rgb(232 240 246 / 0.45);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
  }

  .label {
    position: absolute;
    top: 22px;
    left: 26px;
    pointer-events: none;
  }

  .home {
    pointer-events: auto;
    color: var(--enamel-dim);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .home:hover,
  .home:focus-visible {
    color: var(--enamel);
  }

  h1 {
    margin: 6px 0 0;
    font-size: 30px;
    font-weight: 500;
    letter-spacing: 0.02em;
    line-height: 1.1;
  }

  .species,
  .tank {
    margin: 2px 0 0;
    color: var(--enamel-dim);
    font-size: 14px;
  }

  .hint {
    position: absolute;
    top: 22px;
    right: 26px;
    max-width: 300px;
    margin: 0;
    color: var(--enamel-dim);
    text-align: right;
  }

  .controls {
    position: absolute;
    right: 26px;
    bottom: 26px;
    display: flex;
    gap: 8px;
  }

  .controls button {
    padding: 7px 14px;
    border: 1px solid rgb(232 240 246 / 0.32);
    border-radius: 999px;
    background: rgb(5 7 11 / 0.4);
    color: var(--enamel);
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }

  .controls button:hover,
  .controls button:focus-visible {
    border-color: var(--enamel);
  }

  [hidden] {
    display: none !important;
  }

  .unsupported {
    position: absolute;
    inset: auto 26px 50% 26px;
    margin: 0;
    text-align: center;
  }

  @media (max-width: 640px) {
    .label {
      top: 16px;
      left: 18px;
    }

    h1 {
      font-size: 26px;
    }

    .hint {
      top: 122px;
      left: 18px;
      right: 18px;
      max-width: none;
      text-align: left;
    }

    .controls {
      right: 16px;
      bottom: 16px;
      left: 16px;
      justify-content: flex-end;
      flex-wrap: wrap;
    }
  }
</style>

<script>
  import { start } from './_app';

  const root = document.querySelector<HTMLElement>('[data-sparkle]');
  if (root) start(root);
</script>
