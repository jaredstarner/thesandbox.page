---
import { Font } from 'astro:assets';
import Bare from '../../layouts/Bare.astro';

const description =
  'An oscilloscope wired straight to your speakers. The left channel moves a dot of light sideways, the right moves it up and down, and nothing else draws on the screen.';

const signalKnobs = [
  { name: 'treble', label: 'Treble', value: 0 },
  { name: 'bass', label: 'Bass', value: 0 },
  { name: 'drive', label: 'Drive', value: 0 },
  { name: 'crush', label: 'Crush', value: 0 },
  { name: 'echo', label: 'Echo', value: 0 },
  { name: 'spin', label: 'Spin', value: 0 },
  { name: 'width', label: 'Width', value: 50 },
];
---

<Bare title="XY mode" description={description}>
  <Font cssVariable="--font-xy" slot="head" />
  <main class="xy" data-mode="reel" data-phosphor="p31">
    <div class="stage" data-stage>
      <canvas
        class="tube"
        data-tube
        aria-label="The oscilloscope screen. It shows the page's audio signal as a picture."
      ></canvas>
      <div class="slot" data-slot></div>
      <p class="nogl" data-nogl hidden>
        This tube needs WebGL 2, and this browser isn't offering it.
      </p>
    </div>

    <header class="head">
      <a class="home" href="/">
        thesandbox.page
      </a>
      <h1>XY mode</h1>
      <p class="intro">
        An oscilloscope with its two inputs wired to your speakers. The left channel moves the dot sideways, the right
        channel moves it up and down. Nothing else draws on this screen, so whatever you see is exactly what you hear.
      </p>
    </header>

    <nav class="modes" aria-label="What drives the signal">
      <button type="button" data-go="reel" aria-pressed="true">
        Reel
      </button>
      <button type="button" data-go="keys" aria-pressed="false">
        Keys
      </button>
      <button type="button" data-go="draw" aria-pressed="false">
        Draw
      </button>
      <button type="button" data-go="type" aria-pressed="false">
        Type
      </button>
      <button type="button" data-go="listen" aria-pressed="false">
        Listen
      </button>
    </nav>

    <section class="panel" aria-live="off">
      <div class="pane" data-pane="reel">
        <div class="reelrow">
          <button type="button" class="big" data-reel-toggle>
            Play the reel
          </button>
          <div
            class="progress"
            data-reel-bar
            role="slider"
            aria-label="Position in the reel"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="0"
            tabindex="0"
          >
            <span data-reel-fill></span>
          </div>
          <span class="time" data-reel-time>
            2:50
          </span>
        </div>
        <p class="cue" data-cue>
          Turn your sound on. Until the signal takes over, the dot follows your pointer.
        </p>
      </div>

      <div class="pane" data-pane="keys" hidden>
        <div class="row presets" data-presets></div>
        <div class="keyboard" data-keyboard></div>
        <div class="row">
          <div class="choice" role="group" aria-label="Tuning">
            <button type="button" data-tuning="equal" aria-pressed="true">
              Equal
            </button>
            <button type="button" data-tuning="just" aria-pressed="false">
              Just
            </button>
          </div>
          <button type="button" class="toggle" data-hold aria-pressed="false">
            Hold
          </button>
          <label class="inline">
            Turn <input type="range" min="0" max="100" value="0" data-turn />
          </label>
        </div>
        <p class="cue" data-keys-read>
          Play the keys below, or the Z and Q rows of your keyboard. Hold two notes.
        </p>
      </div>

      <div class="pane" data-pane="draw" hidden>
        <div class="row presets" data-shapes></div>
        <div class="keyboard" data-keyboard-draw></div>
        <p class="cue" data-draw-read>
          Draw on the screen. Whatever you draw starts sounding at once.
        </p>
      </div>

      <div class="pane" data-pane="type" hidden>
        <label class="field">
          <span>Words</span>
          <input type="text" data-text maxlength="200" autocomplete="off" spellcheck="false" placeholder="Type here" />
        </label>
        <p class="cue" data-type-read>
          The beam has to write every letter on each pass, so the more you type, the lower the note.
        </p>
      </div>

      <div class="pane" data-pane="listen" hidden>
        <div class="row">
          <label class="big filebtn">
            Open a sound file
            <input type="file" accept="audio/*" data-file hidden />
          </label>
          <button type="button" class="big" data-mic aria-pressed="false">
            Use the microphone
          </button>
          <button type="button" class="big" data-listen-stop hidden>
            Stop
          </button>
        </div>
        <div class="row" data-twist-row>
          <label class="inline">
            Twist <input type="range" min="1" max="100" value="12" data-twist />
          </label>
        </div>
        <p class="cue" data-listen-read>
          Any stereo recording will draw itself, and files stay on your machine. A mono source reads one channel against
          itself a moment later, set by Twist.
        </p>
      </div>
    </section>

    <aside class="bench" aria-label="Controls">
      <section>
        <h2>
          Signal <small>what you see and hear</small>
        </h2>
        <div class="knobs">
          {signalKnobs.map((k) => (
            <label class="knob">
              <span>{k.label}</span>
              <input type="range" min="0" max="100" value={k.value} data-bench={k.name} />
              <output data-out={k.name}>off</output>
            </label>
          ))}
        </div>
        <button type="button" class="link" data-reset hidden>
          Reset
        </button>
      </section>
      <section>
        <h2>
          Tube <small>only what you see</small>
        </h2>
        <div class="choice phosphors" role="group" aria-label="Phosphor">
          <button type="button" data-phosphor-pick="p31" aria-pressed="true">
            P31
          </button>
          <button type="button" data-phosphor-pick="p3" aria-pressed="false">
            P3
          </button>
          <button type="button" data-phosphor-pick="p11" aria-pressed="false">
            P11
          </button>
          <button type="button" data-phosphor-pick="p7" aria-pressed="false">
            P7
          </button>
        </div>
        <p class="note phosphor-note" data-phosphor-note>
          Green, gone almost at once. Most lab scopes.
        </p>
        <div class="knobs">
          <label class="knob">
            <span>Glow</span>
            <input type="range" min="0" max="100" value="35" data-tube-set="persist" />
          </label>
          <label class="knob">
            <span>Focus</span>
            <input type="range" min="0" max="100" value="20" data-tube-set="focus" />
          </label>
          <label class="knob">
            <span>Bright</span>
            <input type="range" min="0" max="100" value="50" data-tube-set="bright" />
          </label>
          <label class="knob">
            <span>Scale</span>
            <input type="range" min="0" max="100" value="36" data-tube-set="illum" />
          </label>
        </div>
      </section>
      <section>
        <h2>
          Speakers <small>only what you hear</small>
        </h2>
        <div class="knobs">
          <label class="knob">
            <span>Volume</span>
            <input type="range" min="0" max="100" value="65" data-volume />
          </label>
        </div>
      </section>
      <section>
        <button type="button" class="big wide" data-record aria-pressed="false">
          Record a WAV
        </button>
        <p class="note">Play the file into a real oscilloscope in XY mode, and this picture comes up on its screen.</p>
        <p class="note credit">Coastlines: Natural Earth, public domain.</p>
      </section>
    </aside>
  </main>
</Bare>

<style>
  :global(html:has(.xy)) {
    background: #030504;
    color-scheme: dark;
  }
  :global(body:has(.xy)) {
    margin: 0;
    background: #030504;
  }

  .xy {
    --glow: 106 255 148;
    --ink: rgb(var(--glow) / 0.92);
    --dim: rgb(var(--glow) / 0.56);
    --faint: rgb(var(--glow) / 0.2);
    --hair: rgb(var(--glow) / 0.13);
    position: relative;
    display: grid;
    grid-template-columns: minmax(250px, 19vw) minmax(0, 1fr) minmax(250px, 19vw);
    grid-template-rows: minmax(0, 1fr) auto;
    grid-template-areas:
      'head stage bench'
      'modes panel bench';
    min-height: 100dvh;
    box-sizing: border-box;
    color: var(--dim);
    font-family: var(--font-xy), ui-monospace, monospace;
    font-stretch: 75%;
    font-size: 11.5px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  .xy *,
  .xy *::before,
  .xy *::after {
    box-sizing: border-box;
  }
  .stage {
    grid-area: stage;
    min-height: 0;
    position: relative;
  }
  .tube {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: pan-y;
  }
  .xy[data-mode='draw'] .tube {
    touch-action: none;
  }
  .slot {
    position: absolute;
    inset: 22px 0 8px;
    pointer-events: none;
  }
  .xy[data-mode='draw'] .tube {
    cursor: crosshair;
  }
  .nogl {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    text-align: center;
    margin: 0;
    padding: 24px;
    color: var(--ink);
  }
  .nogl[hidden] {
    display: none;
  }
  .head,
  .modes,
  .panel,
  .bench {
    position: relative;
    z-index: 1;
  }

  .head {
    grid-area: head;
    padding: 24px 22px 12px 26px;
    align-self: start;
    max-width: 300px;
  }
  .home {
    color: var(--dim);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .home:hover,
  .home:focus-visible {
    color: var(--ink);
  }
  h1 {
    margin: 26px 0 12px;
    color: var(--ink);
    font-size: 25px;
    font-weight: 300;
    font-stretch: 75%;
    letter-spacing: 0.01em;
    line-height: 1.1;
    text-shadow: 0 0 14px rgb(var(--glow) / 0.5);
  }
  .intro {
    margin: 0;
  }

  .modes {
    grid-area: modes;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    padding: 0 22px 26px 26px;
    align-self: end;
  }
  .modes button {
    all: unset;
    cursor: pointer;
    color: var(--dim);
    font-size: 19px;
    font-weight: 300;
    line-height: 1.3;
    padding: 1px 0;
    transition: color 0.15s;
  }
  .modes button:hover {
    color: var(--ink);
  }
  .modes button[aria-pressed='true'] {
    color: rgb(var(--glow));
    text-shadow: 0 0 12px rgb(var(--glow) / 0.65);
  }
  .modes button[aria-pressed='true']::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    margin: 0 9px 3px 0;
    background: rgb(var(--glow));
    box-shadow: 0 0 9px rgb(var(--glow));
  }
  .modes button:focus-visible,
  .xy button:focus-visible,
  .filebtn:focus-within {
    outline: 1px solid var(--ink);
    outline-offset: 3px;
  }

  .panel {
    grid-area: panel;
    padding: 2px 18px 22px;
    min-height: 92px;
  }
  .pane {
    max-width: 860px;
    margin: 0 auto;
  }
  .pane[hidden] {
    display: none;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
  }
  .cue {
    margin: 9px auto 0;
    min-height: 2.2em;
    max-width: 640px;
    text-align: center;
    color: var(--ink);
    font-size: 12.5px;
    text-wrap: balance;
  }
  .reelrow {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .big {
    all: unset;
    box-sizing: border-box;
    flex: none;
    cursor: pointer;
    padding: 7px 14px 8px;
    border: 1px solid var(--dim);
    border-radius: 2px;
    color: rgb(var(--glow));
    font-size: 12px;
    text-align: center;
    transition:
      background-color 0.15s,
      border-color 0.15s;
  }
  .big:hover {
    background: rgb(var(--glow) / 0.1);
    border-color: var(--dim);
  }
  .big[aria-pressed='true'] {
    background: rgb(var(--glow) / 0.16);
    border-color: var(--ink);
  }
  .big.wide {
    display: block;
    width: 100%;
  }
  .big[hidden] {
    display: none;
  }
  .progress {
    position: relative;
    flex: 1;
    height: 22px;
    cursor: pointer;
    touch-action: none;
  }
  .progress::before {
    content: '';
    position: absolute;
    inset: 10.5px 0 auto;
    height: 1px;
    background: var(--faint);
  }
  .progress span {
    position: absolute;
    left: 0;
    top: 10px;
    height: 2px;
    width: 0;
    background: rgb(var(--glow));
    box-shadow: 0 0 8px rgb(var(--glow) / 0.9);
  }
  .time {
    flex: none;
    font-variant-numeric: tabular-nums;
  }

  .presets {
    justify-content: center;
    margin-bottom: 8px;
    gap: 2px 4px;
  }
  .xy :global(.chip) {
    all: unset;
    cursor: pointer;
    padding: 2px 8px 3px;
    color: var(--dim);
    border-radius: 2px;
  }
  .xy :global(.chip:hover) {
    color: var(--ink);
    background: rgb(var(--glow) / 0.08);
  }
  .xy :global(.chip[aria-pressed='true']) {
    color: rgb(var(--glow));
    background: rgb(var(--glow) / 0.14);
  }
  .xy :global(.chip:focus-visible) {
    outline: 1px solid var(--ink);
  }

  .keyboard {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1px 1px;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .xy :global(.octave) {
    position: relative;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    flex: 1 1 280px;
    max-width: 400px;
    height: 54px;
    gap: 1px;
  }
  .xy :global(.key) {
    all: unset;
    position: relative;
    box-sizing: border-box;
    cursor: pointer;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 3px;
    color: var(--dim);
    font-size: 9.5px;
    background: rgb(var(--glow) / 0.05);
    border: 1px solid var(--hair);
    border-radius: 0 0 2px 2px;
    transition: background-color 0.08s;
  }
  .xy :global(.key.sharp) {
    position: absolute;
    top: 0;
    width: 9%;
    height: 56%;
    z-index: 1;
    background: #06100a;
    border-color: var(--faint);
    padding: 0;
  }
  .xy :global(.key:hover) {
    background: rgb(var(--glow) / 0.13);
  }
  .xy :global(.key.sharp:hover) {
    background: #123020;
  }
  .xy :global(.key[data-on='true']),
  .xy :global(.key.sharp[data-on='true']) {
    background: rgb(var(--glow) / 0.75);
    color: #031006;
    box-shadow: 0 0 14px rgb(var(--glow) / 0.55);
  }
  .xy :global(.key:focus-visible) {
    outline: 1px solid var(--ink);
    z-index: 2;
  }

  .pane[data-pane='keys'] > .row:not(.presets) {
    justify-content: center;
    margin-top: 10px;
  }
  .choice {
    display: inline-flex;
    border: 1px solid var(--faint);
    border-radius: 2px;
  }
  .choice button,
  .toggle {
    all: unset;
    cursor: pointer;
    padding: 2px 10px 3px;
    color: var(--dim);
    border-radius: 1px;
  }
  .toggle {
    border: 1px solid var(--faint);
  }
  .choice button:hover,
  .toggle:hover {
    color: var(--ink);
  }
  .choice button[aria-pressed='true'],
  .toggle[aria-pressed='true'] {
    color: rgb(var(--glow));
    background: rgb(var(--glow) / 0.16);
  }
  .inline {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .inline input {
    width: 130px;
  }
  .field {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 560px;
    margin: 0 auto;
  }
  .field input {
    flex: 1;
    min-width: 0;
    padding: 7px 9px;
    border: 1px solid var(--faint);
    border-radius: 2px;
    background: rgb(var(--glow) / 0.04);
    color: rgb(var(--glow));
    font: inherit;
    font-size: 16px;
    caret-color: rgb(var(--glow));
  }
  .field input::placeholder {
    color: var(--faint);
  }
  .field input:focus {
    outline: none;
    border-color: var(--dim);
  }
  .pane[data-pane='listen'] .row {
    justify-content: center;
    margin-bottom: 6px;
  }
  .filebtn {
    display: inline-block;
  }

  .bench {
    grid-area: bench;
    padding: 24px 26px 24px 18px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-self: start;
    max-height: 100dvh;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: var(--faint) transparent;
  }
  .bench section {
    min-width: 0;
  }
  .bench h2 {
    margin: 0 0 9px;
    padding-bottom: 5px;
    border-bottom: 1px solid var(--hair);
    color: var(--ink);
    font-size: 11.5px;
    font-weight: 500;
  }
  .bench h2 small {
    font-size: 10px;
    font-weight: 300;
    color: var(--dim);
    margin-left: 5px;
  }
  .knobs {
    display: grid;
    gap: 3px;
  }
  .knob {
    display: grid;
    grid-template-columns: 50px minmax(0, 1fr) 54px;
    align-items: center;
    gap: 8px;
    min-height: 23px;
  }
  .knob output {
    text-align: right;
    font-variant-numeric: tabular-nums;
    font-size: 10px;
    white-space: nowrap;
  }
  .knobs .knob:not(:has(output)) {
    grid-template-columns: 50px minmax(0, 1fr);
  }
  .phosphors {
    display: flex;
  }
  .phosphor-note {
    margin: 6px 0 8px;
    min-height: 3em;
  }
  .phosphors button {
    flex: 1;
    text-align: center;
  }
  .link {
    all: unset;
    cursor: pointer;
    margin-top: 5px;
    color: var(--dim);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .link:hover {
    color: var(--ink);
  }
  .link[hidden] {
    display: none;
  }
  .credit {
    color: rgb(var(--glow) / 0.4);
  }
  .note {
    margin: 8px 0 0;
    font-size: 10.5px;
    line-height: 1.5;
  }

  .xy input[type='range'] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    min-width: 0;
    height: 22px;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }
  .xy input[type='range']::-webkit-slider-runnable-track {
    height: 1px;
    background: var(--faint);
  }
  .xy input[type='range']::-moz-range-track {
    height: 1px;
    background: var(--faint);
  }
  .xy input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 3px;
    height: 15px;
    margin-top: -7px;
    border-radius: 1px;
    background: rgb(var(--glow));
    box-shadow: 0 0 7px rgb(var(--glow) / 0.9);
  }
  .xy input[type='range']::-moz-range-thumb {
    width: 3px;
    height: 15px;
    border: 0;
    border-radius: 1px;
    background: rgb(var(--glow));
    box-shadow: 0 0 7px rgb(var(--glow) / 0.9);
  }
  .xy input[type='range']:focus-visible {
    outline: 1px solid var(--dim);
    outline-offset: 1px;
  }

  @media (max-width: 960px) {
    .xy {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }
    .stage {
      order: 0;
      position: sticky;
      top: 0;
      z-index: 2;
      width: 100%;
      height: min(100vw, 54dvh);
      background: #030504;
      flex: none;
    }
    .tube {
      position: absolute;
    }
    .slot {
      inset: 8px;
    }
    .head {
      order: 3;
      max-width: none;
      padding: 8px 18px 14px;
    }
    .home {
      position: absolute;
      right: 18px;
      top: 8px;
    }
    h1 {
      margin: 0 0 8px;
      font-size: 20px;
    }
    .modes {
      order: 1;
      flex-direction: row;
      justify-content: space-between;
      gap: 4px;
      padding: 8px 18px 6px;
      align-self: stretch;
    }
    .modes button {
      font-size: 15px;
    }
    .modes button[aria-pressed='true']::before {
      display: none;
    }
    .panel {
      order: 2;
      padding: 4px 14px 10px;
      min-height: 0;
    }
    .bench {
      order: 4;
      max-height: none;
      overflow: visible;
      padding: 8px 18px 40px;
    }
    .xy :global(.octave) {
      flex-basis: 100%;
      max-width: none;
      height: 50px;
    }
    .knob {
      min-height: 32px;
    }
  }
</style>

<script>
  import './_app';
</script>
