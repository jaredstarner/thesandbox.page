  /* The bagel game: a banner that begs to be clicked. */
  .adhell .bagel {
    margin: 2em 0;
  }

  .adhell .bagel-field {
    position: relative;
    container-type: inline-size;
    height: 110px;
    padding: 10px 14px;
    overflow: hidden;
    background: repeating-linear-gradient(45deg, #1f3cff 0 14px, #2a48ff 14px 28px);
    border: 4px solid #ffe600;
    color: #fff;
    text-align: center;
  }

  .adhell .bagel-title {
    margin: 0;
    font: 900 28px/1 Impact, 'Arial Black', sans-serif;
    color: #ffe600;
    text-shadow: 3px 3px 0 #e3121b;
    letter-spacing: 0.03em;
  }

  .adhell .bagel-sub {
    margin: 4px 0 0;
    font: 700 14px/1 'Comic Sans MS', 'Comic Sans', 'Chalkboard SE', cursive;
  }

  .adhell .bagel-target {
    position: absolute;
    left: 6px;
    bottom: 4px;
    width: 52px;
    height: 52px;
    padding: 0;
    border: 0;
    background: none;
    animation: ah-bagel 2.6s ease-in-out infinite alternate;
  }

  .adhell .bagel-target svg {
    width: 100%;
    height: 100%;
    animation: ah-spin 1.3s linear infinite;
  }

  @keyframes ah-bagel {
    0% {
      translate: 0 0;
    }

    25% {
      translate: 25cqw -34px;
    }

    50% {
      translate: 48cqw 0;
    }

    75% {
      translate: 70cqw -30px;
    }

    100% {
      translate: calc(100cqw - 64px) 0;
    }
  }

  @keyframes ah-spin {
    to {
      rotate: 1turn;
    }
  }

  /* The spoon flashes, but under three times a second (WCAG 2.3.1). */
  .adhell .spoon-in {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    min-height: 250px;
    padding: 14px;
    background: #ffe600;
    color: #000;
    text-align: center;
    cursor: pointer;
    animation: ah-flash 1.2s steps(1) infinite;
  }

  .adhell .spoon-top {
    margin: 0;
    font: 900 22px/1 Impact, 'Arial Black', sans-serif;
  }

  .adhell .spoon-art {
    width: 110px;
    height: 110px;
  }

  .adhell .spoon-bottom {
    margin: 0;
    font: 700 24px/1 'Comic Sans MS', 'Comic Sans', 'Chalkboard SE', cursive;
    text-transform: uppercase;
  }

  .adhell .spoon-bottom b {
    color: #e3121b;
  }

  @keyframes ah-flash {
    0% {
      background: #ffe600;
      color: #000;
    }

    50% {
      background: #ff1fa6;
      color: #fff;
    }
  }

  /* The scrollover: a zero-height slot whose panel sweeps over the text as you scroll past. */
  .adhell .scrollover {
    position: relative;
    height: 0;
    view-timeline: --ah-sweep block;
  }

  .adhell .scrollover-panel {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: calc(var(--hud-h) + 20px) 20px 20px;
    background: linear-gradient(180deg, #e9e3ff, #ffd9c7);
    color: #2c2366;
    text-align: center;
    translate: 0 110vh;
    will-change: translate;
  }

  .adhell .scrollover-panel p {
    margin: 0;
  }

  .adhell .so-ask {
    font: italic 400 clamp(28px, 6vw, 56px)/1.1 Georgia, serif;
  }

  .adhell .so-art {
    width: min(70vw, 380px);
    height: auto;
  }

  .adhell .so-brand {
    font: 900 clamp(40px, 10vw, 96px)/1 'Arial Black', Impact, sans-serif;
    letter-spacing: 0.12em;
    color: #5b4bd1;
  }

  .adhell .so-line {
    max-width: 30ch;
    font-size: 18px;
  }

  .adhell .so-cta {
    padding: 14px 26px;
    border: 0;
    border-radius: 999px;
    background: #5b4bd1;
    color: #fff !important;
    font: 700 16px/1 Arial, sans-serif !important;
  }

  .adhell .so-hint {
    margin-top: 12px !important;
    color: #6c63a8;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /*
   * The timeline goes through a custom property so the minifier can't fold it
   * into the animation shorthand, where not every browser accepts it.
   */
  @supports (animation-timeline: view()) {
    .adhell .scrollover-panel {
      --ah-tl: --ah-sweep;

      animation-name: ah-sweep;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: var(--ah-tl);
      animation-range: cover;
    }
  }

  @keyframes ah-sweep {
    from {
      translate: 0 100vh;
    }

    to {
      translate: 0 -100vh;
    }
  }

  /* A native ad, set in the article's own type. */
  .adhell .native {
    margin: 0 0 1.1em;
  }

  .adhell .native-in {
    cursor: pointer;
    font-family: var(--font-adhell-body);
    line-height: 1.7;
  }

  .adhell .post .native-h {
    margin: 1.4em 0 0.3em;
    font-size: 1.35rem;
  }

  .adhell .post .native-p {
    margin: 0;
  }

  .adhell .native-more {
    color: var(--accent);
    font-weight: 700;
  }

  .adhell .post .native-tag {
    margin: 2px 0 0;
    color: #b9b0a5;
    font: 10px/1.2 Arial, sans-serif;
  }

  /* The chumbox. */
  .adhell .chumbox {
    margin: 2.4em 0;
    padding-top: 10px;
    border-top: 3px solid #222;
  }

  .adhell .chum-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 0 0 10px;
    font: 900 15px/1 Arial, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .adhell .chum-by {
    color: #999;
    font: 400 10px/1 Arial, sans-serif;
    text-transform: none;
    letter-spacing: 0;
  }

  .adhell .chum-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
    gap: 16px 12px;
  }

  .adhell .chum {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
  }

  .adhell .chum svg {
    width: 100%;
    aspect-ratio: 16 / 10;
    height: auto;
  }

  .adhell .chum-t {
    font: 700 15px/1.25 Arial, Helvetica, sans-serif;
    color: #111;
  }

  .adhell .chum:hover .chum-t {
    text-decoration: underline;
  }

  .adhell .chum-s {
    color: #999;
    font-size: 11px;
  }

  /* GRANITE in a box. */
  .adhell .granite .box-in {
    background: radial-gradient(circle at 50% 30%, #6a7077, #1a1c1f 75%);
    color: #e9e4da;
  }

  .adhell .granite .box-art {
    width: 50px;
  }

  .adhell .granite-name {
    font: 900 40px/1 Impact, 'Arial Black', sans-serif;
    letter-spacing: 0.14em;
  }

  .adhell .granite-line {
    font: italic 16px/1.3 Georgia, serif;
  }

  .adhell .granite .cta {
    background: #e9e4da;
    color: #1a1c1f;
  }

  /* Lazy ads: nothing until you have scrolled past, then something. */
  .adhell .lazy {
    height: 0;
  }

  .adhell .lazy[data-loaded] {
    height: auto;
    margin: 1.6em auto;
  }

  /* The rail. */
  /* Beside the article on wide screens; under it on narrow ones, where the deal waits at the bottom. */
  .adhell .rail {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 24px;
    padding: 0 0 40px;
  }

  .adhell .rail .box {
    margin-top: 0;
  }

  .adhell .rail-stick {
    position: sticky;
    top: calc(var(--hud-h) + 16px);
  }

  .adhell .sofa .box-in {
    background: #fdf6ec;
    border: 1px solid #d8c9b2;
    color: #34433c;
  }

  .adhell .sofa .box-art {
    width: 150px;
  }

  .adhell .sofa-line {
    font: 18px/1.25 Georgia, serif;
  }

  .adhell .sofa-sub {
    font: italic 14px/1.3 Georgia, serif;
    color: #7a6e64;
  }

  .adhell .sofa .cta {
    background: #4f7a6a;
    color: #fff;
  }

  .adhell .half-in {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    min-height: 600px;
    padding: 16px;
    background: linear-gradient(180deg, #ff2d2d, #b30000);
    color: #fff;
    text-align: center;
    cursor: pointer;
  }

  .adhell .half-in p {
    margin: 0;
  }

  .adhell .half-badge {
    padding: 6px 10px;
    background: #ffe600;
    color: #b30000;
    font: 900 15px/1 Impact, 'Arial Black', sans-serif;
    letter-spacing: 0.04em;
    rotate: -4deg;
  }

  .adhell .half-art {
    width: 190px;
    height: auto;
    margin: 6px 0;
    filter: drop-shadow(0 10px 10px rgb(0 0 0 / 0.35));
  }

  .adhell .half-name {
    font: 900 28px/1 'Arial Black', Impact, sans-serif;
  }

  .adhell .half-line {
    font-size: 14px;
  }

  .adhell .half-price s {
    opacity: 0.7;
    font-size: 18px;
  }

  .adhell .half-price b {
    font: 900 44px/1 Impact, 'Arial Black', sans-serif;
    color: #ffe600;
  }

  .adhell .half-timer,
  .adhell .half-stock,
  .adhell .half-watch {
    font-size: 14px;
  }

  .adhell .half-timer b {
    font: 700 20px/1 'Courier New', monospace;
    color: #ffe600;
  }

  .adhell .half-in .cta {
    margin-top: auto;
    background: #ffe600;
    color: #b30000;
    font-size: 18px;
  }

  @media (min-width: 1060px) {
    .adhell .layout {
      grid-template-columns: minmax(0, 680px) 300px;
    }

    .adhell .rail {
      display: block;
      padding-top: 40px;
    }
  }

  .adhell:has(.hud-block input:checked) .layout,
  .adhell[data-blocked] .layout {
    grid-template-columns: minmax(0, 680px);
  }

  .adhell:has(.hud-block input:checked) .rail,
  .adhell[data-blocked] .rail {
    display: none;
  }

  /* The sticky banner: a third of the screen. */
  .adhell .sticky {
    position: fixed;
    inset: auto 0 0;
    z-index: 50;
    height: max(34vh, 200px);
    background: linear-gradient(90deg, #ff7a00, #ff2e63);
    color: #fff;
    box-shadow: 0 -8px 30px rgb(0 0 0 / 0.3);
    transition: height 0.5s cubic-bezier(0.2, 0.8, 0.2, 1), translate 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .adhell .sticky[data-compact] {
    height: 72px;
  }

  .adhell .sticky[data-down] {
    translate: 0 110%;
  }

  .adhell .sticky-in {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(12px, 4vw, 40px);
    height: 100%;
    padding: 12px 48px 12px 16px;
    cursor: pointer;
  }

  .adhell .sticky-art {
    height: 80%;
    max-height: 180px;
    width: auto;
  }

  .adhell .sticky-copy p {
    margin: 0;
  }

  .adhell .sticky-name {
    font: 900 clamp(30px, 6vw, 64px)/1 'Arial Black', Impact, sans-serif;
    letter-spacing: 0.04em;
  }

  .adhell .sticky-line {
    font-size: clamp(14px, 2vw, 20px);
  }

  .adhell .sticky .cta {
    background: #fff;
    color: #ff2e63;
    font-size: 18px;
  }

  .adhell .sticky[data-compact] .sticky-name {
    font-size: 24px;
  }

  .adhell .sticky[data-compact] .sticky-line {
    font-size: 13px;
  }

  .adhell .sticky[data-compact] .sticky-art {
    height: 56px;
  }

  .adhell .sticky-x {
    position: absolute;
    top: 8px;
    right: 8px;
    z-index: 1;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.35);
    color: #fff !important;
    font: 700 18px/1 Arial, sans-serif !important;
  }

  @media (max-width: 640px) {
    .adhell .sticky .cta,
    .adhell .sticky[data-compact] .sticky-line {
      display: none;
    }
  }

  /* The site keeps room at the bottom so the sticky banner covers ads, not the end of the recipe. */
  .adhell .site {
    padding-bottom: 72px;
  }

  .adhell .fake-next {
    position: relative;
    margin: 2em 0 0;
    text-align: center;
  }

  .adhell .fake-next-btn {
    padding: 14px 40px;
    border: 2px solid var(--ink);
    background: var(--paper);
    font: 700 16px/1 var(--font-adhell-body) !important;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .adhell .comments {
    margin-top: 3em;
  }

  .adhell .comments ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .adhell .comments li {
    padding: 14px 0;
    border-top: 1px solid var(--rule);
    font-size: 0.95rem;
  }

  .adhell .comments .who {
    margin: 0 0 4px;
    font-weight: 700;
  }

  .adhell .comments .who span {
    margin-left: 6px;
    color: var(--accent);
    letter-spacing: 0.1em;
  }

  .adhell .comments li p:last-child {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .adhell .spoon-in,
    .adhell .bagel-target,
    .adhell .bagel-target svg {
      animation: none;
    }

    .adhell .sticky {
      transition: none;
    }
  }

  /* ---------- Script-driven pieces ---------- */

  html:has(.adhell[data-lock]) {
    overflow: hidden;
  }

  .adhell .hud-flash {
    position: absolute;
    top: calc(100% + 8px);
    left: 12px;
    margin: 0;
    padding: 6px 10px;
    border-radius: 6px;
    background: #ff3b1f;
    color: #fff;
    font: 600 12px/1.2 ui-monospace, 'Cascadia Mono', Consolas, Menlo, monospace;
    opacity: 0;
    translate: 0 -6px;
    pointer-events: none;
    transition: opacity 0.25s, translate 0.25s;
  }

  .adhell .hud-flash.show {
    opacity: 1;
    translate: 0 0;
  }

  /* The video follows you once you scroll past it. */
  .adhell .vid-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #ece5da;
  }

  .adhell .vid-gone {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    color: #a59d93;
    font: italic 15px/1 Georgia, serif;
  }

  .adhell .vid-frame .vid {
    position: absolute;
    inset: 0;
  }

  .adhell .vid-frame .vid.is-pip {
    position: fixed;
    inset: auto 16px 88px auto;
    z-index: 55;
    width: min(360px, 62vw);
    height: auto;
    aspect-ratio: 16 / 9;
    box-shadow: 0 16px 40px -10px rgb(0 0 0 / 0.6);
    outline: 3px solid #ffd400;
  }

  .adhell .vid.is-pip .vid-x {
    position: absolute;
    top: -12px;
    left: -12px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #111;
    color: #fff !important;
    font: 700 16px/1 Arial, sans-serif !important;
  }

  .adhell .vid.is-pip .vid-skip,
  .adhell .vid.is-pip .vid-count {
    font-size: 11px !important;
  }

  .adhell .vid.is-pip .vid-cta {
    padding: 5px 8px;
    font-size: 11px !important;
  }

  /* Late ads. */
  .adhell .lz {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: 100%;
    min-height: 240px;
    justify-content: center;
    padding: 20px;
    border: 0;
    text-align: center;
  }

  .adhell .lz-big {
    font: 900 26px/1.1 'Arial Black', Impact, sans-serif;
  }

  .adhell .lz-quiz {
    background: radial-gradient(circle at 30% 20%, #fff59a, #ff8a00);
    color: #3a1d00 !important;
  }

  .adhell .lz-quiz .cta {
    background: #3a1d00;
    color: #fff59a;
  }

  .adhell .lz-plumb {
    background: #0b5bd3;
    color: #fff !important;
  }

  .adhell .lz-plumb .cta {
    background: #ffd400;
    color: #0b2a6b;
  }

  .adhell .lz-stars {
    background: radial-gradient(circle at 70% 30%, #4b2a8c, #120a2a 70%);
    color: #f1e6ff !important;
  }

  .adhell .lz-stars .cta {
    background: #f1e6ff;
    color: #120a2a;
  }

  .adhell .lz-card {
    min-height: 180px;
    background: linear-gradient(180deg, #ff2d2d, #b30000);
    color: #fff !important;
  }

  .adhell .lz-card .lz-big {
    font-size: 20px;
  }

  .adhell .lz-card .cta {
    background: #ffe600;
    color: #b30000;
  }

  /* Strangers buying things. */
  .adhell .proof {
    position: fixed;
    left: 16px;
    bottom: 88px;
    z-index: 60;
    width: min(330px, 100vw - 32px);
  }

  .adhell .proof-card {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding: 12px 14px;
    border-radius: 8px;
    background: #fff;
    color: #222;
    font-size: 13px;
    line-height: 1.35;
    box-shadow: 0 10px 30px -8px rgb(0 0 0 / 0.35);
    animation: ah-in 0.35s ease-out both;
  }

  .adhell .proof-card.out {
    opacity: 0;
    translate: 0 10px;
    transition: opacity 0.5s, translate 0.5s;
  }

  .adhell .proof-card small {
    display: block;
    margin-top: 3px;
    color: #888;
    font-size: 11px;
  }

  .adhell .proof-dot {
    flex: none;
    width: 10px;
    height: 10px;
    margin-top: 4px;
    border-radius: 50%;
    background: #2fbf71;
    box-shadow: 0 0 0 4px rgb(47 191 113 / 0.25);
  }

  @keyframes ah-in {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }

  /* The notification pre-ask. */
  .adhell .pushask {
    position: fixed;
    top: calc(var(--hud-h) + 10px);
    left: 50%;
    z-index: 65;
    width: min(420px, 100vw - 24px);
    padding: 16px 18px 12px;
    translate: -50% 0;
    border-radius: 10px;
    background: #fff;
    color: #222;
    font-size: 14px;
    line-height: 1.4;
    box-shadow: 0 18px 40px -12px rgb(0 0 0 / 0.45);
    animation: ah-drop 0.35s ease-out both;
  }

  .adhell .pushask p {
    margin: 0;
  }

  .adhell .push-text::before {
    content: '🔔 ';
  }

  .adhell .push-buttons {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 12px !important;
  }

  .adhell .push-buttons button {
    padding: 8px 14px;
    border-radius: 6px;
    border: 0;
  }

  .adhell .push-later {
    background: none;
    color: #999 !important;
  }

  .adhell .push-allow {
    background: #1769e0;
    color: #fff !important;
    font-weight: 700 !important;
  }

  @keyframes ah-drop {
    from {
      opacity: 0;
      translate: -50% -16px;
    }
  }

  /* The chat bubble. */
  .adhell .chat {
    position: fixed;
    right: 16px;
    bottom: 88px;
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
  }

  .adhell:has(.vid.is-pip) .chat {
    bottom: calc(88px + min(360px, 62vw) * 9 / 16 + 16px);
  }

  .adhell .chat-bubble {
    position: relative;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border: 0;
    border-radius: 50%;
    background: #1769e0;
    font-size: 26px !important;
    box-shadow: 0 10px 24px -6px rgb(23 105 224 / 0.6);
  }

  .adhell .chat-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 11px;
    background: #e3121b;
    color: #fff;
    font: 700 12px/22px Arial, sans-serif;
  }

  .adhell .chat-teaser {
    max-width: 240px;
    padding: 10px 14px;
    border: 0;
    border-radius: 14px 14px 4px 14px;
    background: #fff;
    color: #222 !important;
    font-size: 14px !important;
    text-align: left;
    box-shadow: 0 10px 24px -8px rgb(0 0 0 / 0.35);
    animation: ah-in 0.3s ease-out both;
  }

  .adhell .chat-panel {
    display: flex;
    flex-direction: column;
    width: min(320px, 100vw - 32px);
    height: min(420px, 60vh);
    border-radius: 12px;
    background: #fff;
    color: #222;
    overflow: hidden;
    box-shadow: 0 18px 50px -12px rgb(0 0 0 / 0.5);
  }

  .adhell .chat-head {
    display: flex;
    align-items: center;
    gap: 10px;
