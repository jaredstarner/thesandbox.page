---
import { Font } from 'astro:assets';
import Bare from '../../layouts/Bare.astro';
import Art from './_Art.astro';
import { GROUPS, VIOLATIONS, type Group } from './_tally';

const groups = Object.keys(GROUPS) as Group[];
---

<Bare
  title="Ad hell"
  description="A modest toast recipe buried under every ad format the industry agreed to retire. Read it to the end, or flip the ad blocker."
>
  <Font cssVariable="--font-adhell-display" slot="head" />
  <Font cssVariable="--font-adhell-body" slot="head" />
  <Font cssVariable="--font-adhell-hand" slot="head" />

  <main class="adhell" data-adhell>
    <header class="hud" data-hud>
      <a class="hud-home" href="/" title="Back to thesandbox.page"><span aria-hidden="true">←</span><span class="opt"> thesandbox.page</span></a>
      <p class="hud-name">Ad hell</p>
      <p class="hud-goal" data-hud-goal>Read the recipe to the end.</p>
      <ul class="hud-stats" aria-label="Your reading so far">
        <li><span class="k">Time</span> <b data-stat="time">0:00</b></li>
        <li class="opt"><span class="k">Ad clicks</span> <b data-stat="clicks">0</b></li>
        <li class="opt"><span class="k">Ad density</span> <b data-stat="density">-</b></li>
        <li class="opt"><span class="k" data-stat-label="cls">CLS</span> <b data-stat="cls">-</b></li>
      </ul>
      <button class="hud-btn hud-viol" type="button" popovertarget="ah-checklist" title="Violations seen so far">
        <b data-stat="seen">0</b>/{VIOLATIONS.length}<span class="opt"> violations</span>
      </button>
      <button class="hud-btn hud-sound" type="button" data-sound aria-pressed="true" title="Sound">
        <span aria-hidden="true">♪</span><span class="vh">Sound</span>
      </button>
      <label class="hud-block" title="Hide every ad on the page">
        <input type="checkbox" data-block autocomplete="off" />
        <span class="sw" aria-hidden="true"></span>
        <span>Block ads</span>
      </label>
      <p class="hud-flash" data-hud-flash aria-live="polite"></p>
    </header>

    <div class="site" data-site>
      <div class="ad leader" data-violation="density-30">
        <p class="ad-label">Advertisement</p>
        <button class="leader-in" type="button" data-cta="breadcoin">
          <span class="coin" aria-hidden="true">B</span>
          <span class="leader-name">BREADCOIN</span>
          <span class="leader-tick">▲ 412% this week</span>
          <span class="leader-line">The currency backed by actual bread.</span>
          <span class="cta">Buy now</span>
        </button>
      </div>

      <header class="masthead">
        <p class="logo"><span>The</span> Toastmonger</p>
        <p class="motto">recipes, stories &amp; crumbs</p>
        <nav class="sitenav" aria-label="The Toastmonger">
          <span>Recipes</span>
          <span>Stories</span>
          <span>Shop</span>
          <span>About</span>
        </nav>
      </header>

      <div class="layout">
        <article class="post" data-post>
          <header class="post-head">
            <p class="kicker">Breakfast · Five ingredients or fewer</p>
            <h1>The Best Buttered Toast You'll Ever Make</h1>
            <p class="dek">A family recipe, a few thoughts on mornings, and, eventually, toast.</p>
            <p class="byline">
              By Wren Halloway · <a class="jump" href="#recipe" data-jump>Jump to recipe</a>
            </p>
          </header>

          <div class="ad disguise" data-violation="disguised-ads">
            <button class="fake-btn go" type="button" data-cta="recipejumper">▼ JUMP TO RECIPE</button>
            <button class="fake-btn dl" type="button" data-cta="filewizard">⬇ DOWNLOAD RECIPE (PDF)</button>
            <span class="ad-tag">Ad</span>
          </div>

          <p>
            Some mornings ask for very little. A window, a kettle working itself up to a boil, and a slice of bread on its way
            to becoming something better. This is a recipe for that slice.
          </p>
          <p>
            I know what you're thinking: toast doesn't need a recipe. You're right. But it does deserve one, the way a good
            chair deserves to be sat in properly. So pull one up. The recipe is at the bottom, and I promise it's worth the
            scroll.
          </p>

          <div class="ad video-slot" data-video-slot>
            <p class="ad-label">Advertisement</p>
            <div class="vid-frame">
              <p class="vid-gone" aria-hidden="true">This ad is following you ↘</p>
              <div class="vid" data-video>
                <canvas class="vid-canvas" data-video-canvas width="640" height="360" aria-label="A video advertisement"></canvas>
                <p class="vid-poster" aria-hidden="true">GRANITE</p>
                <div class="vid-ui">
                  <span class="vid-count" data-video-count>Ad 1 of 3</span>
                  <button class="vid-btn vid-cta" type="button" data-cta="granite" data-video-cta>Learn more ›</button>
                  <button class="vid-btn vid-mute" type="button" data-video-mute aria-pressed="false" title="Mute this ad">
                    <span aria-hidden="true">🔊</span><span class="vh">Mute</span>
                  </button>
                  <button class="vid-btn vid-skip" type="button" data-video-skip disabled>Skip ad in 5</button>
                  <button class="vid-x" type="button" data-video-close aria-label="Close video">×</button>
                  <span class="vid-bar"><i data-video-bar></i></span>
                </div>
              </div>
            </div>
          </div>

          <h2>My toast story</h2>
          <p>
            My grandmother's toaster browned exactly one side of anything you put in it. Nobody remembers it working any other
            way. She'd stand beside it with a butter knife in one hand and the other hovering over the lever, and when the
            first side came up the color of an old church pew she'd flip the slice and send it down again. It took twice as
            long as toast should. It was the best toast I have ever eaten.
          </p>

          <aside class="ad box loafly" data-violation="fake-close visual-interference" data-large>
            <p class="ad-label">Advertisement</p>
            <div class="box-in" data-cta="loafly">
              <Art name="loaf" uid="box" class="box-art" />
              <p class="loafly-name">LOAFLY</p>
              <p class="loafly-line">Fresh bread every six hours. Whether you like it or not.</p>
              <span class="cta">Start free trial</span>
              <span class="fakex" data-fakex aria-hidden="true">×</span>
            </div>
            <p class="ad-foot"><button class="realx" type="button" data-close-ad>close ad</button></p>
          </aside>

          <p>
            I used to think the secret was the toaster. Then I thought it was the bread, a dense brown loaf from a bakery that
            has since become a phone shop. It took me years to understand that the secret was the waiting: she gave each side
            its full attention, and she buttered it the moment it came up, while it was still hot enough to drink the butter
            in.
          </p>
          <div class="ad lazy" data-lazy="quiz"></div>
          <p>
            When she gave me the toaster, it lasted one more winter. I've owned four since. None of them burn on one side only,
            and I still flip my bread out of habit, which my partner finds either charming or deranged depending on the hour.
          </p>

          <aside class="ad bagel" data-violation="density-30">
            <p class="ad-label">Advertisement</p>
            <div class="bagel-field">
              <p class="bagel-title">BONK THE BAGEL!</p>
              <p class="bagel-sub">Win a FREE* toaster</p>
              <button class="bagel-target" type="button" data-bagel aria-label="Bonk the bagel">
                <Art name="bagel" />
              </button>
            </div>
          </aside>

          <h2>Why this recipe works</h2>
          <p>
            Heat, then fat, then salt, in that order and without a pause between them. Toast that sits on a plate for even a
            minute starts to steam itself soft from underneath. Butter that goes on cold tears the surface and pools in the
            middle. Get the timing right and the rest takes care of itself.
          </p>

          <aside class="ad box spoon" data-violation="flashing" data-large>
            <p class="ad-label">Advertisement</p>
            <div class="spoon-in" data-cta="spoon">
              <p class="spoon-top">!!! ONE WEIRD SPOON !!!</p>
              <Art name="spoon" class="spoon-art" />
              <p class="spoon-bottom">Chefs are <b>FURIOUS</b></p>
            </div>
          </aside>

          <p>
            It's also forgiving. Too pale, and you send it back down. Too dark, and you scrape it over the sink the way
            everyone's parents did, and nobody has to know.
          </p>
          <div class="ad lazy" data-lazy="plumber"></div>

          <div class="ad scrollover" data-scrollover>
            <div class="scrollover-panel" data-violation="scrollover">
              <p class="ad-label">Advertisement</p>
              <p class="so-ask">You look tired.</p>
              <Art name="mattress" uid="so" class="so-art" />
              <p class="so-brand">SNOOZLE</p>
              <p class="so-line">The 400-night trial. Sleep on it. Then sleep on it 399 more times.</p>
              <button class="so-cta" type="button" data-cta="snoozle">Find my firmness</button>
              <p class="so-hint">Scroll to keep reading ↓</p>
            </div>
          </div>

          <h2>A word about bread</h2>
          <p>
            Use bread you'd happily eat untoasted. A sourdough with an open crumb gives you crisp edges and soft valleys for the
            butter to settle in. A plain sandwich loaf gives you even, golden toast from corner to corner. Day-old bread toasts
            better than fresh, because some of its moisture has already left, so this is the best possible use for the end of
            a loaf.
          </p>

          <aside class="ad native" data-violation="disguised-ads">
            <div class="native-in" data-cta="clickwell">
              <h2 class="native-h">7 Breads Nutritionists Won't Stop Talking About</h2>
              <p class="native-p">
                Number four is just a photo of a baguette, and it changed how we think about lunch. <span class="native-more">Keep reading ›</span>
              </p>
              <p class="native-tag">Sponsored · Clickwell</p>
            </div>
          </aside>

          <p>
            Slice it about as thick as your little finger. Thinner slices dry out before they color. Thicker ones stay doughy
            in the middle, which some people love and I won't argue with.
          </p>
          <div class="ad lazy" data-lazy="horoscope"></div>

          <h2>A word about butter</h2>
          <p>
            Salted, and soft. Leave it out on the counter overnight, or at least while the kettle boils. If you only have cold
            butter, shave thin curls of it with a vegetable peeler and lay them on the hot toast; they'll melt in seconds.
          </p>
          <p>Spread it to the very edges. The crust deserves butter too.</p>

          <aside class="ad chumbox" data-violation="chumbox">
            <p class="chum-head"><span>Around the Web</span><span class="chum-by">Promoted by Clickwell</span></p>
            <div class="chum-grid">
              <button class="chum" type="button" data-cta="clickwell">
                <Art name="chum-crouton" />
                <span class="chum-t">Doctors Can't Explain Why This Crouton Is So Crunchy</span>
                <span class="chum-s">BreadDaily</span>
              </button>
              <button class="chum" type="button" data-cta="clickwell">
                <Art name="chum-attic" />
                <span class="chum-t">Toasters From Your Childhood Could Be Worth a Fortune. Check Your Attic</span>
                <span class="chum-s">HomeyHacks</span>
              </button>
              <button class="chum" type="button" data-cta="clickwell">
                <Art name="chum-jam" />
                <span class="chum-t">She Put the Jam on First. Her Family Hasn't Spoken Since</span>
                <span class="chum-s">KitchenFeud</span>
              </button>
              <button class="chum" type="button" data-cta="clickwell">
                <Art name="chum-mistake" />
                <span class="chum-t">The One Bread Mistake Almost Everyone Makes Every Morning</span>
                <span class="chum-s">CrumbFacts</span>
              </button>
              <button class="chum" type="button" data-cta="clickwell">
                <Art name="chum-cat" />
                <span class="chum-t">Cats Are Doing Something Strange With Bread, and Nobody Knows Why</span>
                <span class="chum-s">PawPost</span>
              </button>
              <button class="chum" type="button" data-cta="clickwell">
                <Art name="chum-town" />
                <span class="chum-t">Locals Are Furious About This Town's New Butter Rule</span>
                <span class="chum-s">TheDailyKnead</span>
              </button>
            </div>
          </aside>

          <h2>Frequently asked questions</h2>
          <dl class="faq">
            <dt>Can I make this ahead?</dt>
            <dd>No. Toast is a present-tense food.</dd>
            <dt>Can I freeze it?</dt>
            <dd>You can freeze the bread, and toast it straight from frozen. Give it an extra minute.</dd>
            <dt>Is this recipe gluten-free?</dt>
            <dd>Only if your bread is.</dd>
            <dt>Can I use a microwave?</dt>
            <dd>I can't stop you. I would rather you didn't.</dd>
            <dt>What should I drink with it?</dt>
            <dd>Tea, coffee, or a glass of cold milk, ideally at a window.</dd>
          </dl>

          <aside class="ad box granite" data-violation="fake-close visual-interference" data-large>
            <p class="ad-label">Advertisement</p>
            <div class="box-in" data-cta="granite">
              <Art name="can" uid="box" class="box-art" />
              <p class="granite-name">GRANITE</p>
              <p class="granite-line">Smell like a countertop.</p>
              <span class="cta">Get the spray</span>
              <span class="fakex" data-fakex aria-hidden="true">×</span>
            </div>
            <p class="ad-foot"><button class="realx" type="button" data-close-ad>close ad</button></p>
          </aside>

          <section class="card" id="recipe" aria-labelledby="recipe-title">
            <p class="card-kicker">Recipe</p>
            <h2 id="recipe-title">Buttered toast</h2>
            <p class="card-meta"><span>Prep 1 min</span><span>Cook 3 min</span><span>Serves 1</span></p>
            <h3>Ingredients</h3>
            <ul>
              <li>1 slice of good bread, about as thick as your little finger</li>
              <li>1 tablespoon salted butter, softened</li>
              <li>A pinch of flaky salt (optional)</li>
            </ul>
            <div class="ad lazy" data-lazy="card"></div>
            <h3>Method</h3>
            <ol>
              <li>Toast the bread until it's deep golden on both sides. If your toaster browns only one side, flip it and go again.</li>
              <li>Butter it the moment it comes out, all the way to the edges.</li>
              <li>Add a pinch of salt if you like. Eat it right away, standing up in the kitchen if you must.</li>
            </ol>
            <p class="card-end" data-end>That's it. That's the recipe.</p>
            <p class="signoff">xo, Wren</p>
          </section>

          <section class="comments" aria-labelledby="comments-title">
            <h2 id="comments-title">Comments (3)</h2>
            <ol>
              <li>
                <p class="who">Marla K. <span aria-label="One star out of five">★☆☆☆☆</span></p>
                <p>I used a bagel instead of bread and margarine instead of butter, and I skipped the toasting. It was not toast.</p>
              </li>
              <li>
                <p class="who">toastlover88 <span aria-label="Five stars out of five">★★★★★</span></p>
                <p>Made this for the whole family. Took about forty minutes, mostly closing things. Worth it.</p>
              </li>
              <li>
                <p class="who">Dale <span aria-label="Five stars out of five">★★★★★</span></p>
                <p>Haven't made it yet but I'm sure it's great.</p>
              </li>
            </ol>
          </section>

          <div class="ad fake-next" data-violation="disguised-ads">
            <button class="fake-next-btn" type="button" data-cta="clickwell">Next page ›</button>
            <span class="ad-tag">Ad</span>
          </div>
        </article>

        <aside class="rail" aria-label="Advertisements">
          <div class="ad box sofa" data-violation="retargeting" data-large>
            <p class="ad-label">Advertisement</p>
            <div class="box-in" data-cta="slouchmore">
              <Art name="sofa" class="box-art" />
              <p class="sofa-line">Still thinking about the <b>Slouchmore</b>?</p>
              <p class="sofa-sub">It's still thinking about you.</p>
              <span class="cta">Take me back</span>
            </div>
          </div>
          <div class="rail-stick">
            <div class="ad half" data-violation="fake-urgency fake-scarcity" data-large>
              <p class="ad-label">Advertisement</p>
              <div class="half-in" data-cta="crumbtronic">
                <p class="half-badge">70% OFF · TODAY ONLY</p>
                <Art name="toaster" uid="rail" class="half-art" />
                <p class="half-name">CRUMBTRONIC 3000</p>
                <p class="half-line">The toaster that texts you when it's done.</p>
                <p class="half-price"><s>$499</s> <b>$149</b></p>
                <p class="half-timer">Deal ends in <b data-urgency>04:59</b></p>
                <p class="half-stock">Only <b data-stock>3</b> left in stock!</p>
                <p class="half-watch"><b data-watchers>17</b> people are looking at this right now</p>
                <span class="cta">Shop now</span>
              </div>
            </div>
          </div>
        </aside>
      </div>

      <footer class="site-foot">
        <p>The Toastmonger is invented, and so is every brand on this page. <a href="/">Back to thesandbox.page</a></p>
      </footer>
    </div>

    <div class="ad sticky" data-sticky data-violation="sticky-large">
      <button class="sticky-x" type="button" data-sticky-close aria-label="Close">×</button>
      <div class="sticky-in" data-cta="sokkit">
        <Art name="socks" class="sticky-art" />
        <div class="sticky-copy">
          <p class="sticky-name">SOKKIT</p>
          <p class="sticky-line">Smart socks. Know where the other one is. Always.</p>
        </div>
        <span class="cta">Pair now</span>
      </div>
    </div>

    <div class="ad proof" data-proof></div>

    <div class="ad pushask" data-pushask hidden>
      <p class="push-text" data-push-text></p>
      <p class="push-buttons" data-push-buttons>
        <button type="button" class="push-later" data-push="later">Maybe later</button>
        <button type="button" class="push-allow" data-push="allow">Allow</button>
      </p>
    </div>

    <div class="ad chat" data-chat hidden>
      <div class="chat-panel" data-chat-panel hidden>
        <p class="chat-head">
          <span class="chat-face" aria-hidden="true">🍞</span>
