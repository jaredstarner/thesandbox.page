---
// Product shots and thumbnails for the invented ads, drawn here so every one is original.
// `uid` keeps gradient ids unique when a piece appears more than once.

interface Props {
  name: string;
  uid?: string;
  class?: string;
}

const { name, uid = name, class: className } = Astro.props;
const id = (part: string) => `ah-${uid}-${part}`;
const url = (part: string) => `url(#${id(part)})`;

// The clickbait house style: a red ring and a red arrow pointing at not much.
const ring = (cx: number, cy: number, rx: number, ry: number) =>
  `<ellipse cx="${cx}" cy="${cy}" rx="${rx}" ry="${ry}" fill="none" stroke="#e3121b" stroke-width="4"/>`;
const arrow = (x1: number, y1: number, x2: number, y2: number) => {
  const a = Math.atan2(y2 - y1, x2 - x1);
  const h = 12;
  const p1 = [x2 - h * Math.cos(a - 0.5), y2 - h * Math.sin(a - 0.5)];
  const p2 = [x2 - h * Math.cos(a + 0.5), y2 - h * Math.sin(a + 0.5)];
  const f = (n: number) => n.toFixed(1);
  return (
    `<line x1="${x1}" y1="${y1}" x2="${f(x2 - 6 * Math.cos(a))}" y2="${f(y2 - 6 * Math.sin(a))}" stroke="#e3121b" stroke-width="5" stroke-linecap="round"/>` +
    `<path d="M${x2} ${y2}L${f(p1[0])} ${f(p1[1])}L${f(p2[0])} ${f(p2[1])}Z" fill="#e3121b"/>`
  );
};

