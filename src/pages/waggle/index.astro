---
import { Font } from 'astro:assets';
import Bare from '../../layouts/Bare.astro';

const description =
  "A honeybee's dance floor and the valley round the hive: read a forager's waggle dance, mark the map, send a bee to see if you read it right, then dance for the flowers yourself.";
---

<Bare title="Waggle" description={description}>
  <Font cssVariable="--font-wg-head" slot="head" />
  <Font cssVariable="--font-wg-text" slot="head" />
  <main class="waggle" data-stage="intro">
    <header class="bar">
      <p class="home">
        <a href="/">thesandbox.page</a>
      </p>
      <h1 class="title">Waggle</h1>
      <div class="sky" aria-live="off">
        <svg class="sun-icon" viewBox="-12 -12 24 24" aria-hidden="true">
          <circle r="5" />
          <g class="rays">
            <path d="M0 -10.5V-7.5M0 7.5V10.5M-10.5 0H-7.5M7.5 0H10.5M-7.4 -7.4L-5.3 -5.3M5.3 5.3L7.4 7.4M-7.4 7.4L-5.3 5.3M5.3 -5.3L7.4 -7.4"></path>
          </g>
        </svg>
        <p>
          <span data-day>Day 1</span>{' '}
          <span class="time" data-time>
            08:30
          </span>
        </p>
      </div>
      <p class="loads">
        <span class="n" data-loads>
          0
        </span>{' '}
        <span data-loads-word>loads home</span>
      </p>
      <div class="tools">
        <button type="button" class="tool" popovertarget="wg-how">
          How to read a dance
        </button>
        <button type="button" class="tool" data-slow aria-pressed="false" title="Slow motion (S)">
          Slow
        </button>
        <button type="button" class="tool" data-sound aria-pressed="true" title="Sound">
          Sound
        </button>
      </div>
    </header>

    <p class="prompt" data-prompt role="status">
      A forager has come home with news.
    </p>

    <div class="stage">
      <section class="pane comb-pane" aria-label="The dance floor, just inside the hive entrance">
        <canvas class="comb" data-comb></canvas>
        <p class="pane-label">The dance floor</p>
        <div class="dancers" data-dancers hidden></div>
        <button type="button" class="watch" data-watch aria-pressed="false">
          <span class="face" aria-hidden="true"></span>
          <span class="watch-text">
            <span data-watch-label>Hold to time a run</span>
            <b data-watch-read>0.00 s</b>
          </span>
        </button>
        <p class="you" data-you hidden></p>
        <div class="result" data-result hidden>
          <h2 data-result-title></h2>
          <p data-result-line></p>
          <p class="lesson" data-result-lesson hidden></p>
          <div class="actions">
            <button type="button" class="go" data-dance hidden>
              Dance for it
            </button>
            <button type="button" class="go quiet" data-next>
              Next forager
            </button>
          </div>
        </div>
      </section>

      <section class="pane map-pane" aria-label="The valley around the hive, seen from above">
        <canvas class="map" data-map></canvas>
        <p class="pane-label">The valley</p>
        <p class="readout" data-readout hidden></p>
        <button type="button" class="send" data-send hidden>
          Send a bee
        </button>
      </section>
    </div>

    <div class="card intro" data-intro>
      <h2>A forager has come home</h2>
      <p>
        She has found flowers somewhere in the valley, and she is telling her sisters where with a dance: a straight run
        with her body waggling, a loop back round, and the run again. The run points the way, measured from the sun. How
        long it lasts says how far.
      </p>
      <p>Watch her, mark the map where you think she means, and send a bee to find out whether you read her right.</p>
      <button type="button" class="go" data-start>
        Go into the hive
      </button>
      <p class="small">Best with sound on.</p>
      <noscript>
        <p class="small">The hive needs JavaScript.</p>
      </noscript>
    </div>

    <div class="card dusk" data-dusk hidden>
      <h2 data-dusk-title>Evening</h2>
      <p data-dusk-line></p>
      <ol class="diary" data-diary></ol>
      <button type="button" class="go" data-morning>
        Next morning
      </button>
    </div>

    <aside class="how" id="wg-how" popover>
      <h2>How to read a dance</h2>
      <svg class="figure" viewBox="0 0 520 230" role="img" aria-labelledby="wg-fig-title">
        <title id="wg-fig-title">
          On the comb, a waggle run 40 degrees right of straight up means flowers 40 degrees right of the sun.
        </title>
        <g class="fig-comb">
          <rect x="10" y="10" width="220" height="210" rx="10"></rect>
          <line class="up" x1="120" y1="190" x2="120" y2="40"></line>
          <path class="up-head" d="M114 50 120 38 126 50"></path>
          <text x="120" y="30" text-anchor="middle">
            straight up
          </text>
          <path class="loop" d="M181.7 96.5 A48 48 0 0 1 120.0 170.0"></path>
          <path class="loop" d="M181.7 96.5 A48 48 0 0 0 120.0 170.0"></path>
          <path
            class="wag"
            d="M120.0 170.0 L121.0 169.5 L122.3 169.4 L123.3 168.9 L123.3 167.6 L122.3 165.4 L121.1 163.1 L121.3 162.0 L123.1 162.1 L125.8 163.1 L128.5 164.1 L130.2 164.2 L130.5 163.1 L129.5 161.0 L127.9 158.4 L126.9 156.2 L127.1 155.1 L128.9 155.2 L131.6 156.2 L134.3 157.2 L136.0 157.3 L136.3 156.3 L135.2 154.1 L133.7 151.5 L132.6 149.3 L132.9 148.2 L134.6 148.3 L137.4 149.3 L140.1 150.3 L141.8 150.4 L142.1 149.4 L141.0 147.2 L139.5 144.6 L138.4 142.4 L138.7 141.3 L140.4 141.5 L143.1 142.4 L145.9 143.4 L147.6 143.5 L147.9 142.5 L146.8 140.3 L145.3 137.7 L144.2 135.5 L144.5 134.4 L146.2 134.6 L148.9 135.5 L151.6 136.5 L153.4 136.7 L153.6 135.6 L152.6 133.4 L151.0 130.8 L150.0 128.6 L150.3 127.5 L152.0 127.7 L154.7 128.6 L157.4 129.6 L159.2 129.8 L159.4 128.7 L158.4 126.5 L156.8 123.9 L155.8 121.7 L156.0 120.6 L157.8 120.8 L160.5 121.7 L163.2 122.7 L164.9 122.9 L165.2 121.8 L164.2 119.6 L162.6 117.0 L161.6 114.8 L161.8 113.7 L163.6 113.9 L166.3 114.8 L169.0 115.8 L170.7 116.0 L171.0 114.9 L170.0 112.7 L168.4 110.1 L167.4 107.9 L167.6 106.8 L169.4 107.0 L172.1 108.0 L174.8 108.9 L176.5 109.1 L176.8 108.0 L175.7 105.8 L174.2 103.2 L173.1 101.0 L173.4 99.9 L175.1 100.1 L177.9 101.1 L180.2 101.7 L181.2 101.3 L181.2 99.9 L180.8 98.3 L180.9 97.1 L181.7 96.5"
          ></path>
          <path class="dir" d="M177.9 93.2 L185.6 91.9 L185.5 99.7"></path>
          <path class="arc" d="M120 110 A 60 60 0 0 1 158.6 124"></path>
          <text class="deg" x="150" y="108">
            40°
          </text>
          <text x="120" y="212" text-anchor="middle">
            on the comb
          </text>
        </g>
        <g class="fig-map">
          <rect x="290" y="10" width="220" height="210" rx="10"></rect>
          <circle class="sun" cx="400" cy="34" r="9"></circle>
          <line class="sunline" x1="400" y1="170" x2="400" y2="48"></line>
          <path class="run" d="M400 170 L464 94"></path>
          <circle class="flowers" cx="464" cy="94" r="7"></circle>
          <path class="arc" d="M400 110 A 60 60 0 0 1 438.6 124"></path>
          <text class="deg" x="430" y="108">
            40°
          </text>
          <rect class="hive" x="393" y="166" width="14" height="10" rx="2"></rect>
          <text x="400" y="212" text-anchor="middle">
            in the valley
          </text>
        </g>
      </svg>
      <p>
        <b>Direction.</b> Inside the hive it is dark and the comb hangs straight down, so the dancer uses gravity for
        the sun. Straight up the comb stands for the direction of the sun. A run 40° right of straight up sends her
        sisters 40° right of the sun. As the sun moves across the sky, the same flowers are danced at a new angle.
      </p>
      <p>
        <b>Distance.</b> The longer the waggle run, the farther the flowers. A bee judges distance by how fast the
        ground slides past her eyes, so open water, which barely seems to move, counts for much less than the same
        stretch of fields: a patch across the lake is danced as if it were nearer.
      </p>
      <p>
        <b>Worth.</b> The better the flowers, the faster she loops back for the next run, and the more runs she dances.
      </p>
      <p class="small">
        Karl von Frisch worked out the dance language in the 1940s. The over-water effect was measured by Jürgen Tautz
        and colleagues in 2004, with feeders moved step by step across a lake.
      </p>
      <button type="button" class="go quiet" popovertarget="wg-how" popovertargetaction="hide">
        Back to the hive
      </button>
    </aside>
  </main>
</Bare>

<style>
  .waggle {
    --ink: #2b1d0e;
    --ink-soft: #6a5638;
    --paper: #f4ecd9;
    --paper-deep: #e9dcbf;
    --honey: #e3a02f;
    --honey-deep: #b8731b;
    --wood: #6b4422;
    --mark: #2f5fd0;
    --mark-soft: rgba(47, 95, 208, 0.16);
    --found: #3f8a3a;
    --miss: #c0542b;
    --radius: 16px;
    --head: var(--font-wg-head), Georgia, serif;
    --text: var(--font-wg-text), 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;

    position: relative;
    box-sizing: border-box;
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto auto minmax(0, 1fr);
    gap: 10px;
    padding: 14px 22px 20px;
    color: var(--ink);
    background:
      radial-gradient(120% 80% at 50% 0%, rgba(255, 250, 235, 0.9), transparent 70%),
      linear-gradient(180deg, var(--paper), var(--paper-deep));
    font-family: var(--text);
    font-size: 15px;
    line-height: 1.45;
    isolation: isolate;
  }

  :global(body:has(.waggle)) {
    margin: 0;
    background: #e9dcbf;
  }

  .waggle *,
  .waggle *::before,
  .waggle *::after {
    box-sizing: border-box;
  }

  .waggle [hidden] {
    display: none !important;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .home {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.02em;
  }

  .home a {
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid rgba(106, 86, 56, 0.35);
  }

  .home a:hover {
    color: var(--ink);
  }

  .title {
    margin: 0;
    font-family: var(--head);
    font-weight: 400;
    font-size: 30px;
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .sky {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .sky p {
    margin: 0;
    font-weight: 600;
  }

  .time {
    font-variant-numeric: tabular-nums;
    margin-left: 4px;
  }

  .sun-icon {
    width: 24px;
    height: 24px;
  }

  .sun-icon circle {
    fill: var(--honey);
  }

  .sun-icon path {
    stroke: var(--honey-deep);
    stroke-width: 1.8;
    stroke-linecap: round;
    fill: none;
  }

  .loads {
    margin: 0;
    color: var(--ink-soft);
  }

  .loads .n {
    color: var(--ink);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .tools {
    display: flex;
    gap: 6px;
  }

  .tool {
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    background: rgba(255, 252, 244, 0.7);
    border: 1px solid rgba(43, 29, 14, 0.18);
    border-radius: 999px;
    padding: 6px 12px;
    cursor: pointer;
  }

  .tool:hover {
    background: #fffaf0;
  }

  .tool[aria-pressed='true'] {
    background: var(--ink);
    color: var(--paper);
    border-color: var(--ink);
  }

  .tool[data-sound][aria-pressed='false'] {
    color: var(--ink-soft);
    text-decoration: line-through;
  }

  .prompt {
    margin: 0;
    min-height: 1.45em;
    font-size: 16px;
    font-weight: 500;
    text-wrap: balance;
  }

  .stage {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1fr);
    gap: 16px;
    min-height: 0;
  }

  .pane {
    position: relative;
    min-height: 0;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .comb-pane {
    background: #3a2410;
    box-shadow:
      0 0 0 6px var(--wood),
      0 0 0 7px rgba(0, 0, 0, 0.25),
      0 14px 30px rgba(60, 35, 10, 0.28);
    margin: 7px;
  }

  .map-pane {
    background: #c9bf98;
    box-shadow:
      0 0 0 1px rgba(43, 29, 14, 0.2),
      0 14px 30px rgba(60, 35, 10, 0.2);
  }

  .comb,
  .map {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    touch-action: none;
  }

  .pane-label {
    position: absolute;
    top: 12px;
    left: 14px;
    margin: 0;
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    pointer-events: none;
  }

  .comb-pane .pane-label {
    color: #f6e2b0;
    background: rgba(30, 18, 6, 0.55);
  }

  .map-pane .pane-label {
    color: var(--ink);
    background: rgba(255, 250, 238, 0.82);
  }

  .watch {
    position: absolute;
    left: 12px;
    bottom: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px 8px 8px;
    font: inherit;
    color: #fbefd0;
    background: rgba(30, 18, 6, 0.72);
    border: 1px solid rgba(246, 226, 176, 0.25);
    border-radius: 999px;
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
  }

  .watch[aria-pressed='true'] {
    background: rgba(120, 70, 12, 0.92);
    border-color: #f2c76b;
  }

  .watch .face {
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 2px solid #f2c76b;
    background:
      linear-gradient(var(--hand, 0deg), transparent 47%, #f2c76b 47% 53%, transparent 53%) center / 2px 60% no-repeat,
      radial-gradient(circle, #f2c76b 0 2px, transparent 2.5px),
      #2a180a;
    position: relative;
  }

  .watch .face::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 2px;
    height: 11px;
    background: #f2c76b;
    transform-origin: 50% 100%;
    transform: translate(-50%, -100%) rotate(var(--hand, 0deg));
  }

  .watch .face {
    background: radial-gradient(circle, #f2c76b 0 2px, transparent 2.5px), #2a180a;
  }

  .watch-text {
    display: grid;
    line-height: 1.15;
    text-align: left;
  }

  .watch-text span {
    font-size: 11px;
    letter-spacing: 0.04em;
    opacity: 0.85;
  }

  .watch-text b {
    font-size: 17px;
    font-variant-numeric: tabular-nums;
  }

  .dancers {
    position: absolute;
    top: 46px;
    left: 14px;
    display: flex;
    gap: 6px;
  }

  .dancers :global(button) {
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    color: #fbefd0;
    background: rgba(30, 18, 6, 0.6);
    border: 1px solid rgba(246, 226, 176, 0.25);
    border-radius: 999px;
    padding: 4px 10px 4px 6px;
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
  }

  .dancers :global(button[aria-pressed='true']) {
    background: rgba(246, 226, 176, 0.95);
    color: var(--ink);
  }

  .dancers :global(.dot) {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    box-shadow: inset 0 -2px 0 rgba(0, 0, 0, 0.2);
  }

  .you {
    position: absolute;
    right: 12px;
    bottom: 12px;
    margin: 0;
    max-width: 60%;
    padding: 8px 12px;
    font-size: 13px;
    color: #fbefd0;
    background: rgba(30, 18, 6, 0.72);
    border-radius: 12px;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .readout {
    position: absolute;
    left: 12px;
    bottom: 12px;
    margin: 0;
    max-width: calc(100% - 170px);
    padding: 8px 12px;
    font-size: 13px;
    line-height: 1.35;
    background: rgba(255, 250, 238, 0.92);
    border-radius: 12px;
    box-shadow: 0 2px 10px rgba(43, 29, 14, 0.15);
  }

  .readout :global(b) {
    font-variant-numeric: tabular-nums;
  }

  .send {
    position: absolute;
    right: 12px;
    bottom: 12px;
    font: inherit;
    font-weight: 700;
    font-size: 15px;
    color: #fff;
    background: var(--mark);
    border: 0;
    border-radius: 999px;
    padding: 11px 20px;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(47, 95, 208, 0.35);
  }

  .send:hover {
    background: #2450b8;
  }

  .result {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    padding: 14px 16px;
    background: rgba(255, 250, 238, 0.96);
    border-radius: 14px;
    box-shadow: 0 6px 24px rgba(43, 29, 14, 0.22);
  }

  .result h2 {
    margin: 0 0 4px;
    font-family: var(--head);
    font-weight: 400;
    font-size: 21px;
  }

  .result p {
    margin: 0 0 8px;
  }

  .result .lesson {
    padding: 8px 10px;
    border-left: 3px solid var(--honey);
    background: rgba(227, 160, 47, 0.12);
    font-size: 14px;
  }

  .actions {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .go {
    font: inherit;
    font-weight: 700;
    color: var(--paper);
    background: var(--ink);
    border: 0;
    border-radius: 999px;
    padding: 10px 18px;
    cursor: pointer;
  }

  .go:hover {
    background: #46301a;
  }

  .go.quiet {
    color: var(--ink);
    background: transparent;
    box-shadow: inset 0 0 0 1.5px rgba(43, 29, 14, 0.4);
  }

  .go.quiet:hover {
    background: rgba(43, 29, 14, 0.06);
  }

  .card {
    position: absolute;
    z-index: 5;
    left: 50%;
    top: 50%;
    width: min(500px, calc(100% - 32px));
    transform: translate(-50%, -50%);
    padding: 26px 28px 22px;
    background: #fffaf0;
    border-radius: 20px;
    box-shadow:
      0 0 0 1px rgba(43, 29, 14, 0.12),
      0 24px 60px rgba(43, 29, 14, 0.3);
  }

  .card h2 {
    margin: 0 0 10px;
    font-family: var(--head);
    font-weight: 400;
    font-size: 28px;
    line-height: 1.1;
  }

  .card p {
    margin: 0 0 12px;
  }

  .small {
    font-size: 13px;
    color: var(--ink-soft);
  }

  .waggle[data-stage='intro'] .stage,
  .waggle[data-stage='dusk'] .stage {
    filter: saturate(0.85) brightness(0.92);
  }

  .diary {
    margin: 0 0 16px;
    padding: 0;
    list-style: none;
    max-height: 40svh;
    overflow: auto;
  }

  .diary :global(li) {
    display: grid;
    grid-template-columns: 3.4em 1fr auto;
    gap: 10px;
    padding: 6px 0;
    border-bottom: 1px solid rgba(43, 29, 14, 0.1);
    font-size: 14px;
  }

  .diary :global(.t) {
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
  }

  .diary :global(.ok) {
    color: var(--found);
    font-weight: 700;
  }

  .diary :global(.no) {
    color: var(--miss);
    font-weight: 700;
  }

  .how {
    width: min(600px, calc(100% - 32px));
    max-height: calc(100svh - 32px);
    overflow: auto;
    padding: 24px 28px;
    color: var(--ink);
    background: #fffaf0;
    border: 0;
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(43, 29, 14, 0.35);
    font-family: var(--text);
    font-size: 15px;
    line-height: 1.5;
  }

  .how::backdrop {
    background: rgba(43, 29, 14, 0.35);
  }

  .how h2 {
    margin: 0 0 12px;
    font-family: var(--head);
    font-weight: 400;
    font-size: 26px;
  }

  .how p {
    margin: 0 0 12px;
  }

  .figure {
    width: 100%;
    height: auto;
    margin: 0 0 14px;
    font-family: var(--text);
    font-size: 12px;
  }

  .figure text {
    fill: var(--ink-soft);
  }

  .fig-comb rect {
    fill: #4a2e12;
  }

  .fig-comb text {
    fill: #f2dca8;
  }

  .fig-comb .up,
  .fig-comb .up-head {
    stroke: #f2dca8;
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
    fill: none;
  }

  .fig-comb .up-head {
    stroke-dasharray: none;
  }

  .fig-map rect {
    fill: #dfe3b5;
  }

  .fig-map .sunline {
    stroke: var(--honey-deep);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
  }

  .fig-map .sun {
    fill: var(--honey);
  }

  .fig-map .flowers {
    fill: #8f6fc0;
