---
import Bare from '../../layouts/Bare.astro';
---

<Bare
  title="Teletext"
  description="A working teletext service: key a page number, wait for it to come round, and read today's news, weather, markets, and earthquakes in forty columns of block graphics."
>
  <main class="teletext" data-teletext>
    <a class="home" href="/">thesandbox.page</a>

    <div class="set">
      <div class="tube">
        <canvas class="screen" data-screen aria-hidden="true"></canvas>
        <div class="glass" aria-hidden="true"></div>
      </div>
    </div>

    <noscript>
      <p class="nojs">The set is warming up, but it needs JavaScript to tune in.</p>
    </noscript>
  </main>
</Bare>

<style is:global>
  body:has(.teletext) {
    margin: 0;
    background: #0b0b0d;
  }

  .teletext {
    --surround: #0b0b0d;
    min-height: 100svh;
    box-sizing: border-box;
    color: #c9c7c2;
    font: 15px/1.4 system-ui, sans-serif;
  }

  .teletext .home {
    position: absolute;
    top: 14px;
    left: 16px;
    color: #8d8a84;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .teletext .tube {
    position: relative;
    aspect-ratio: 4 / 3;
    background: #000;
  }

  .teletext .screen {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
