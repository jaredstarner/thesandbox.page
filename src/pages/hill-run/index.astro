---
import { Font } from 'astro:assets';
import Bare from '../../layouts/Bare.astro';

const BILLS = [
  {
    id: 'bomb',
    no: 'No. 1',
    name: 'Hill bomb',
    place: 'Calloway Street, 6:04 a.m.',
    line: 'Seven blocks of hill on a skateboard, and the street sweeper behind you has lost its brakes.',
  },
  {
    id: 'cheese',
    no: 'No. 2',
    name: 'Cheese roll',
    place: "Hob's Edge, the last Monday in May",
    line: 'Chase a wheel of cheese down a bank too steep to run. They always send a second one after you.',
  },
  {
    id: 'luge',
    no: 'No. 3',
    name: 'Luge',
    place: 'The Black Vein, night session',
    line: 'Twelve curves of floodlit ice, feet first, and the four-man bob is already in the chute.',
  },
];
---

<Bare
  title="Hill run"
  description="Three ways down a hill: bomb a city street on a skateboard, chase a cheese down a grass bank, and ride a luge through floodlit night, each with something coming down behind you."
>
  <Font cssVariable="--font-hillrun-bill" slot="head" />
  <Font cssVariable="--font-hillrun-text" slot="head" />

  <main class="hillrun" data-hillrun data-screen="rack" data-level="bomb">
    <canvas
      class="hill"
      data-hill
      aria-label="The hill from above, with you near the top of the view and the way down below."
    ></canvas>

    <section class="rack" data-rack aria-labelledby="hr-title">
      <header class="masthead">
        <a class="home" href="/">
          thesandbox.page
        </a>
        <h1 id="hr-title">Hill run</h1>
        <p class="strap">Three ways down. Get to the bottom of one and the next bill goes up.</p>
      </header>
      <ol class="bills">
        {BILLS.map((b, i) => (
          <li>
            <button class="bill" type="button" data-pick={b.id} data-ink={b.id} disabled={i > 0}>
              <canvas class="art" data-art={b.id} aria-hidden="true" />
              <span class="no">{b.no}</span>
              <span class="name">{b.name}</span>
              <span class="place">{b.place}</span>
              <span class="line">{b.line}</span>
              <span class="best" data-best={b.id}>
                {i === 0 ? 'Not yet run' : `Finish No. ${i} to print this bill`}
              </span>
            </button>
          </li>
        ))}
      </ol>
      <p class="keys">
        <span>
          <kbd>←</kbd> <kbd>→</kbd> steer
        </span>
        <span>
          <kbd>↓</kbd> tuck
        </span>
        <span>
          <kbd>↑</kbd> brake
        </span>
        <span>or hold on the hill to steer toward your finger</span>
        <span>gamepads work too</span>
      </p>
    </section>

    <div class="hud" data-hud hidden>
      <p class="tag title" data-hud-title></p>
      <div class="dials">
        <p class="tag clock">
          <span data-clock>0:00.00</span>
        </p>
        <p class="tag speed">
          <span data-speed>0</span>
          <small>km/h</small>
        </p>
      </div>
      <p class="chaser" data-chaser hidden></p>
      <p class="call" data-call aria-live="polite"></p>
      <p class="count" data-count></p>
      <div class="strip" aria-hidden="true">
        <canvas data-strip></canvas>
      </div>
    </div>

    <section class="card" data-card hidden aria-live="polite">
      <p class="kicker" data-card-kicker></p>
      <h2 data-card-title></h2>
      <dl class="stats" data-card-stats></dl>
      <p class="note" data-card-note></p>
      <div class="actions">
        <button type="button" data-again>
          Run it again <kbd>R</kbd>
        </button>
        <button type="button" data-next hidden>
          Next bill
        </button>
        <button type="button" data-back>
          All bills <kbd>Esc</kbd>
        </button>
      </div>
    </section>

    <button class="sound" type="button" data-sound aria-pressed="true">
      Sound on
    </button>
  </main>
</Bare>

<style>
  .hillrun {
    --paper: #f1e6cf;
    --key: #232637;
    --red: #d4482f;
    --gold: #f0b13c;
    --bill: var(--font-hillrun-bill), Impact, sans-serif;
    --text: var(--font-hillrun-text), Arial, sans-serif;
    position: fixed;
    inset: 0;
    overflow: hidden;
    background: var(--paper);
    color: var(--key);
    font-family: var(--text);
    user-select: none;
    -webkit-user-select: none;
    touch-action: none;
  }

  .hillrun[data-level='cheese'] {
    --paper: #f4ead2;
    --key: #2c3320;
    --red: #cf4b33;
    --gold: #f2c24a;
  }

  .hillrun[data-level='luge'] {
    --paper: #eef1f2;
    --key: #14203a;
    --red: #c8323c;
    --gold: #f2b84b;
  }

  :global(body:has(.hillrun)) {
    margin: 0;
    background: #f1e6cf;
    overscroll-behavior: none;
  }

  [hidden] {
    display: none !important;
  }

  .hill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  /* ---------------------------------------------------------- the bill rack */

  .rack {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    touch-action: pan-y;
    padding: clamp(16px, 4vw, 48px);
    background: radial-gradient(ellipse at 50% 0%, rgb(255 255 255 / 0.35), transparent 60%), #2b2a2e;
    color: #f1e6cf;
  }

  .masthead {
    max-width: 1180px;
    margin: 0 auto clamp(18px, 3vw, 32px);
    display: grid;
    gap: 6px;
  }

  .home {
    font: 600 13px/1 var(--text);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #c8bda4;
    text-decoration: none;
    justify-self: start;
  }

  .home:hover,
  .home:focus-visible {
    color: #f1e6cf;
  }

  .masthead h1 {
    margin: 0;
    font: 400 clamp(64px, 11vw, 148px) / 0.82 var(--bill);
    letter-spacing: 0.01em;
    text-transform: uppercase;
    color: #f1e6cf;
  }

  .strap {
    margin: 4px 0 0;
    font-size: clamp(15px, 1.6vw, 18px);
    color: #c8bda4;
    max-width: 52ch;
  }

  .bills {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1180px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(14px, 2.4vw, 32px);
  }

  .bill {
    --ink: #d4482f;
    --stock: #f1e6cf;
    --dark: #232637;
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto auto 1fr auto;
    align-content: start;
    width: 100%;
    aspect-ratio: 5 / 7;
    padding: 0;
    border: 0;
    background: var(--stock);
    color: var(--dark);
    text-align: left;
    cursor: pointer;
    font: inherit;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.15) inset,
      0 18px 30px -12px rgb(0 0 0 / 0.65);
    transform: rotate(var(--tilt, 0deg));
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
    overflow: hidden;
  }

  .bills li:nth-child(1) .bill {
    --tilt: -1.2deg;
  }
  .bills li:nth-child(2) .bill {
    --tilt: 0.8deg;
  }
  .bills li:nth-child(3) .bill {
    --tilt: -0.6deg;
  }

  .bill[data-ink='cheese'] {
    --ink: #cf4b33;
    --stock: #f4ead2;
    --dark: #2c3320;
  }

  .bill[data-ink='luge'] {
    --ink: #c8323c;
    --stock: #eef1f2;
    --dark: #14203a;
  }

  .bill:not(:disabled):hover,
  .bill:not(:disabled):focus-visible {
    transform: rotate(0deg) translateY(-6px);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.15) inset,
      0 28px 40px -14px rgb(0 0 0 / 0.75);
    outline: none;
  }

  .bill:focus-visible::after {
    content: '';
    position: absolute;
    inset: 6px;
    border: 3px solid var(--ink);
    pointer-events: none;
  }

  .bill:disabled {
    cursor: default;
  }

  /* The bill's top third is printed solid in its ink, the title knocked out of it. */
  .bill::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 42%;
    background: var(--ink);
    clip-path: polygon(0 0, 100% 0, 100% 78%, 0 100%);
  }

  .art {
    grid-row: 1 / -1;
    grid-column: 1;
    width: 100%;
    height: 100%;
    display: block;
  }

  .bill > span {
    grid-column: 1;
    position: relative;
    padding: 0 clamp(14px, 1.6vw, 22px);
  }

  .no {
    grid-row: 1;
    padding-top: clamp(12px, 1.6vw, 20px) !important;
    font: 700 12px/1 var(--text);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--stock);
  }

  .name {
    grid-row: 2;
    font: 400 clamp(52px, 6.2vw, 92px) / 0.86 var(--bill);
    text-transform: uppercase;
    color: var(--stock);
    margin-top: 6px;
  }

  .place {
    grid-row: 3;
    font: 600 clamp(12px, 1.1vw, 14px) / 1.3 var(--text);
    color: var(--stock);
    margin-top: 6px;
  }

  .line {
    grid-row: 5;
    align-self: end;
    font: 400 clamp(13px, 1.15vw, 15px) / 1.38 var(--text);
    color: var(--dark);
    background: var(--stock);
    padding-top: 12px !important;
    padding-bottom: 6px !important;
  }

  .best {
    grid-row: 6;
    font: 400 clamp(20px, 1.8vw, 26px) / 1 var(--bill);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--stock);
    background: var(--ink);
    padding-top: 10px !important;
    padding-bottom: 10px !important;
  }

  .bill:disabled::before {
    background: color-mix(in srgb, var(--dark) 22%, var(--stock));
  }

  .bill:disabled .art {
    filter: grayscale(1) contrast(0.7) brightness(1.15);
    opacity: 0.55;
  }

  .bill:disabled .name,
  .bill:disabled .no,
  .bill:disabled .place {
    color: var(--dark);
    opacity: 0.55;
  }

  .bill:disabled .best {
    background: transparent;
    color: var(--dark);
    border-top: 2px dashed currentColor;
    opacity: 0.7;
    font-size: clamp(16px, 1.4vw, 20px);
  }

  .keys {
    max-width: 1180px;
    margin: clamp(20px, 3vw, 36px) auto 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-size: 14px;
    color: #c8bda4;
  }

  kbd {
    display: inline-block;
    min-width: 1.6em;
    padding: 2px 5px;
    border: 1px solid currentColor;
    border-radius: 3px;
    font: 600 12px/1.2 var(--text);
    text-align: center;
  }

  /* ---------------------------------------------------------- the run */

  .hud {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .tag {
    margin: 0;
    background: var(--paper);
    color: var(--key);
    box-shadow: 3px 3px 0 var(--key);
  }

  .title {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 8px 12px 6px;
    font: 400 clamp(24px, 3vw, 34px) / 0.9 var(--bill);
    text-transform: uppercase;
    background: var(--red);
    color: var(--paper);
  }

  .title :global(small) {
    display: block;
    font: 600 11px/1.3 var(--text);
    letter-spacing: 0.08em;
    margin-top: 4px;
  }

  .dials {
    position: absolute;
    top: 16px;
    right: 16px;
    display: grid;
    justify-items: end;
    gap: 10px;
  }

  .clock {
    padding: 6px 12px 4px;
    font: 400 clamp(32px, 4.4vw, 52px) / 1 var(--bill);
    font-variant-numeric: tabular-nums;
  }

  .speed {
    padding: 4px 10px 3px;
    font: 400 clamp(22px, 2.6vw, 30px) / 1 var(--bill);
    font-variant-numeric: tabular-nums;
  }

  .speed small {
    font: 600 11px/1 var(--text);
    margin-left: 4px;
    letter-spacing: 0.06em;
  }

  .chaser {
    position: absolute;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    padding: 6px 12px 5px;
    background: var(--key);
    color: var(--paper);
    font: 400 clamp(18px, 2vw, 24px) / 1 var(--bill);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .chaser[data-close] {
    background: var(--red);
    animation: hr-throb 0.5s steps(2) infinite;
  }

  @keyframes hr-throb {
    50% {
      filter: brightness(1.25);
    }
  }

  .call {
    position: absolute;
    left: 50%;
    bottom: calc(76px + env(safe-area-inset-bottom));
    transform: translateX(-50%);
    margin: 0;
    padding: 0 12px;
    font: 400 clamp(26px, 3.4vw, 40px) / 1 var(--bill);
    text-transform: uppercase;
    color: var(--paper);
    -webkit-text-stroke: 0;
    text-shadow:
      2px 2px 0 var(--key),
      -1px -1px 0 var(--key),
      1px -1px 0 var(--key),
      -1px 1px 0 var(--key);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .call[data-on] {
    opacity: 1;
  }

  .count {
    position: absolute;
    left: 50%;
    top: 46%;
    transform: translate(-50%, -50%);
    margin: 0;
    font: 400 clamp(64px, 12vw, 160px) / 0.9 var(--bill);
    text-transform: uppercase;
    text-align: center;
    color: var(--red);
    text-shadow: 5px 5px 0 var(--key);
    max-width: 92vw;
  }

  .count :global(small) {
    display: block;
    font-size: 0.32em;
    color: var(--key);
    text-shadow: none;
    background: var(--paper);
    padding: 6px 10px 4px;
    margin-top: 12px;
  }

  .strip {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: calc(12px + env(safe-area-inset-bottom));
    height: 54px;
    background: var(--paper);
    box-shadow: 3px 3px 0 var(--key);
  }

  .strip canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ---------------------------------------------------------- the result */

  .card {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%) rotate(-1deg);
    width: min(440px, calc(100vw - 32px));
    padding: 22px 24px 20px;
    background: var(--paper);
    color: var(--key);
    box-shadow: 6px 6px 0 var(--key);
  }

  .kicker {
    margin: 0;
    font: 700 12px/1 var(--text);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--red);
  }

  .card h2 {
    margin: 6px 0 14px;
    font: 400 clamp(52px, 9vw, 76px) / 0.86 var(--bill);
    text-transform: uppercase;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, auto);
    justify-content: start;
    gap: 4px 26px;
    margin: 0 0 12px;
  }

  .stats :global(div) {
    display: grid;
    gap: 2px;
  }

  .stats :global(dt) {
    font: 600 11px/1 var(--text);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
  }

  .stats :global(dd) {
    margin: 0;
    font: 400 32px/1 var(--bill);
    font-variant-numeric: tabular-nums;
  }

  .note {
    margin: 0 0 16px;
    font-size: 15px;
    line-height: 1.4;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .actions button,
  .sound {
    font: 600 14px/1 var(--text);
    padding: 10px 14px;
    border: 2px solid var(--key);
    background: var(--paper);
    color: var(--key);
    cursor: pointer;
  }

  .actions button:first-child {
    background: var(--key);
    color: var(--paper);
  }

  .actions button kbd {
    margin-left: 6px;
    font-size: 11px;
    padding: 1px 4px;
  }

  .actions button:hover,
  .actions button:focus-visible,
  .sound:hover,
  .sound:focus-visible {
    outline: 3px solid var(--red);
    outline-offset: 2px;
  }

  .sound {
    position: absolute;
    right: 16px;
    bottom: calc(80px + env(safe-area-inset-bottom));
    padding: 7px 10px;
    font-size: 12px;
    box-shadow: 3px 3px 0 var(--key);
  }

  .hillrun[data-screen='rack'] .sound {
    top: clamp(16px, 4vw, 48px);
    bottom: auto;
    right: clamp(16px, 4vw, 48px);
    background: #2b2a2e;
    color: #c8bda4;
    border-color: #c8bda4;
    box-shadow: none;
  }

  @media (max-width: 860px) {
    .bills {
      grid-template-columns: minmax(0, 1fr);
      max-width: 420px;
    }

    .bill {
      aspect-ratio: 4 / 4.4;
    }
  }

  @media (max-width: 560px) {
    .title {
      top: 12px;
      left: 12px;
    }

    .dials {
      top: 12px;
      right: 12px;
      gap: 8px;
    }

    .chaser {
      top: auto;
      bottom: calc(80px + env(safe-area-inset-bottom));
    }

    .call {
      bottom: calc(124px + env(safe-area-inset-bottom));
    }

    .strip {
      left: 12px;
      right: 12px;
      height: 46px;
    }

    .hillrun:not([data-screen='rack']) .sound {
      top: 92px;
      left: 12px;
      right: auto;
      bottom: auto;
    }
  }
</style>

<script>
  import { startHillRun } from './_app';

  const root = document.querySelector<HTMLElement>('[data-hillrun]');
  if (root) startHillRun(root);
</script>
