---
import Base from '../../../layouts/Base.astro';
import BackHome from '../../../theme/BackHome.astro';

// Every seed is an empty, identical <i>. Where it sits, how big it is, and how
// bright it glows all come from CSS reading its place among its siblings.
const SEEDS = 800;
const arms = [8, 13, 21, 34];
---

<Base
  title="The golden angle"
  description="Eight hundred seeds placed by CSS sibling-index() alone. Scroll to twist the angle between them."
>
  <BackHome />

  <div class="track">
    <div class="stage">
      <p class="hint">scroll to twist</p>

      <div class="head" aria-hidden="true">
        {Array.from({ length: SEEDS }, () => <i />)}
      </div>

      <div class="readout">
        <p class="angle" aria-hidden="true"></p>
        <p class="golden">the golden angle</p>
      </div>

      <fieldset class="arms">
        <legend>Trace every</legend>
        <label><input type="radio" name="arm" value="0" checked /> none</label>
        {
          arms.map((n) => (
            <label>
              <input type="radio" name="arm" value={n} data-arm={n} /> {n}th
            </label>
          ))
        }
      </fieldset>

      <p class="unsupported">
        This browser doesn't support <code>sibling-index()</code> yet, so every seed lands in the same spot.
      </p>
    </div>
  </div>

  <article>
    <h1>The golden angle</h1>
    <p>
      Sunflowers place each new seed about 137.5&deg; around from the last. That angle splits a full turn by the golden
      ratio, so no two seeds ever line up, and the head packs tight with no gaps. Nudge the angle a fraction of a degree
      either way and the seeds fall into spokes.
    </p>
    <p>
      This page has no JavaScript. The seed head is {SEEDS} empty <code>&lt;i&gt;</code> elements with no classes and
      no inline styles. Each one works out its own place from <code>sibling-index()</code> and
      <code>sibling-count()</code>, which became Baseline in 2026:
    </p>
    <pre><code>{`i {
  --p: progress(sibling-index(), 1, sibling-count());
  transform:
    rotate(calc(sibling-index() * var(--turn) * 1deg))
    translateX(calc(sqrt(sibling-index() / sibling-count()) * var(--radius)));
}`}</code></pre>
    <p>
      <code>--turn</code> is a registered custom property, driven by a scroll-driven animation that spends most of its
      length near 137.508&deg;. The number at the bottom is the same property, split into digits with
      <code>round()</code> and <code>mod()</code> and printed with CSS counters.
    </p>
    <p>
      Tracing every 13th or 21st seed picks out one spiral arm at the golden angle, because 13 and 21 are Fibonacci
      numbers. Away from it, the same seeds line up in a straight spoke.
    </p>
  </article>
</Base>

<style>
  @property --turn {
    syntax: '<number>';
    inherits: true;
    initial-value: 137.508;
  }

  @property --whole {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }

  @property --frac {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }

  @property --d1 {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }

  @property --d2 {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }

  @property --d3 {
    syntax: '<integer>';
    inherits: false;
    initial-value: 0;
  }

  .track {
    height: 700vh;
    view-timeline: --track;
  }

  .stage {
    /* Leave room under the head for the readout. */
    --radius: min(44vw, calc(50dvh - 4.5rem));
    --turn: 137.508;

    position: sticky;
    top: 0;
    height: 100dvh;
    overflow: hidden;
    display: grid;
    grid-template-rows: 1fr auto;
    place-items: center;
    padding-block: var(--space-5) var(--space-3);
    background: radial-gradient(circle at 50% 45%, var(--color-sky-bottom), var(--color-sky-top) 75%);
  }

  /*
   * The timeline goes through a custom property so the minifier can't fold it
   * into the animation shorthand, where not every browser accepts it.
   */
  @supports (animation-timeline: view()) {
    .stage {
      --timeline: --track;
    }

    .stage,
    .golden {
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: var(--timeline);
      animation-range: contain;
    }

    .stage {
      animation-name: twist;
    }

    .golden {
      animation-name: golden;
    }
  }

  /* Most of the scroll is spent within a degree of the golden angle. */
  @keyframes twist {
    0% {
      --turn: 90;
    }
    30% {
      --turn: 135;
    }
    44% {
      --turn: 137.45;
    }
    50% {
      --turn: 137.508;
    }
    56% {
      --turn: 137.57;
    }
    70% {
      --turn: 140;
    }
    100% {
      --turn: 180;
    }
  }

  @keyframes golden {
    0%,
    45%,
    55%,
    100% {
      opacity: 0;
    }
    48%,
    52% {
      opacity: 1;
    }
  }

  /* ---- seeds ---------------------------------------------------------------- */

  .head {
    position: relative;
    width: 0;
    height: 0;
  }

  .head i {
    --p: progress(sibling-index(), 1, sibling-count());
    /* Spacing between neighbours when the head is evenly packed. */
    --gap: calc(var(--radius) * sqrt(pi / sibling-count()));
    --size: calc(var(--gap) * (0.4 + 0.45 * var(--p)));

    position: absolute;
    width: var(--size);
    height: var(--size);
    margin: calc(var(--size) / -2);
    transform: rotate(calc(sibling-index() * var(--turn) * 1deg))
      translateX(calc(sqrt(sibling-index() / sibling-count()) * var(--radius)));
    animation: sprout 1.1s var(--ease-out) backwards;
    animation-delay: calc(sibling-index() * 1.2ms);
  }

  .head i::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-sand);
    opacity: calc(0.35 + 0.65 * var(--p));
    transition:
      scale var(--duration-base) var(--ease-out),
      background-color var(--duration-base) var(--ease-out);
  }

  .head i:hover::before {
    scale: 2.6;
    opacity: 1;
    background: var(--color-accent);
  }

  /* Scaling the positioned seed grows it out from the centre of the head. */
  @keyframes sprout {
    from {
      scale: 0;
    }
  }

  .stage:has([data-arm]:checked) .head i::before {
    opacity: calc(0.12 + 0.28 * var(--p));
  }

  .stage:has([data-arm='8']:checked) .head i:nth-child(8n)::before,
  .stage:has([data-arm='13']:checked) .head i:nth-child(13n)::before,
  .stage:has([data-arm='21']:checked) .head i:nth-child(21n)::before,
  .stage:has([data-arm='34']:checked) .head i:nth-child(34n)::before {
    opacity: 1;
    background: var(--color-relic);
    box-shadow: 0 0 calc(var(--size) * 0.8) var(--color-relic);
  }

  /* ---- readout -------------------------------------------------------------- */

  .readout {
    text-align: center;
    pointer-events: none;
  }

  .readout p {
    margin: 0;
  }

  /* --turn split into digits and printed with counters. */
  .angle {
    --whole: round(down, var(--turn), 1);
    --frac: clamp(0, round(calc((var(--turn) - var(--whole)) * 1000)), 999);
    --d1: round(down, var(--frac) / 100, 1);
    --d2: round(down, mod(var(--frac), 100) / 10, 1);
    --d3: mod(var(--frac), 10);

    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    line-height: 1;
    counter-reset: whole var(--whole) d1 var(--d1) d2 var(--d2) d3 var(--d3);
  }

  .angle::before {
    content: counter(whole) '.' counter(d1) counter(d2) counter(d3) '\b0';
  }

  .golden {
    color: var(--color-relic);
    font-family: var(--font-display);
    font-style: italic;
  }

  .hint {
    position: absolute;
    top: var(--space-3);
    left: 50%;
    translate: -50% 0;
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  /* ---- controls --------------------------------------------------------------- */

  .arms {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    display: grid;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-size: var(--text-sm);
    backdrop-filter: blur(8px);
  }

  .arms legend {
    float: left;
    padding: 0;
    color: var(--color-muted);
  }

  .arms label {
    display: flex;
    gap: var(--space-1);
    align-items: center;
    cursor: pointer;
  }

  .arms input {
    accent-color: var(--color-relic);
  }

  @media (width < 40rem) {
    .stage {
      --radius: min(46vw, calc(50dvh - 9rem));

      grid-template-rows: auto 1fr;
      padding-block: calc(var(--space-5) + var(--space-2)) 7rem;
    }

    .readout {
      grid-row: 1;
    }

    .hint {
      right: var(--space-3);
      left: auto;
      translate: none;
      padding-top: var(--space-1);
    }

    .head {
      grid-row: 2;
    }

    .arms {
      left: var(--space-3);
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1) var(--space-3);
    }

    .arms legend {
      width: 100%;
    }
  }

  .unsupported {
    display: none;
    position: absolute;
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    max-width: min(24rem, 80vw);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    text-align: center;
  }

  @supports not (order: sibling-index()) {
    .unsupported {
      display: block;
    }
  }

  /* ---- write-up --------------------------------------------------------------- */

  article {
    max-width: 40rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-3);
  }

  article h1 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }

  pre {
    overflow-x: auto;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-size: var(--text-sm);
  }

  @media (prefers-reduced-motion: reduce) {
    .head i {
      animation: none;
    }

    .head i::before {
      transition: none;
    }
  }
</style>
