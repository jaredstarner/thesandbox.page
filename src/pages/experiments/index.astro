---
import Base from '../../layouts/Base.astro';
import BackHome from '../../theme/BackHome.astro';
import { getExperiments } from '../../experiments/list';

const experiments = await getExperiments();
const dateFormat = new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeZone: 'UTC' });
---

<Base title="Experiments" description="Every experiment on thesandbox.page, newest first.">
  <BackHome />
  <main>
    <h1>Experiments</h1>
    {
      experiments.length === 0 ? (
        <p class="empty">Nothing built yet. Check back tomorrow.</p>
      ) : (
        <ol>
          {experiments.map((experiment) => (
            <li>
              <a href={experiment.href}>{experiment.title}</a>
              <p>{experiment.summary}</p>
              <time datetime={experiment.date.toISOString().slice(0, 10)}>
                {dateFormat.format(experiment.date)}
              </time>
            </li>
          ))}
        </ol>
      )
    }
  </main>
</Base>

<style>
  main {
    max-width: 40rem;
    margin: 0 auto;
    padding: var(--space-6) var(--space-3);
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
  }

  ol {
    padding: 0;
    list-style: none;
  }

  li {
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
  }

  li a {
    font-family: var(--font-display);
    font-size: var(--text-lg);
  }

  li p {
    margin: var(--space-1) 0;
  }

  time,
  .empty {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
</style>
